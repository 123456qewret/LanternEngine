diff --git a/gpu/shadps4/video_core/host_shaders/hdr_output.frag b/gpu/shadps4/video_core/host_shaders/hdr_output.frag
new file mode 100644
index 0000000..e227a37
--- /dev/null
+++ b/gpu/shadps4/video_core/host_shaders/hdr_output.frag
@@ -0,0 +1,84 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// bbport: HDR output. The game's SDR picture (letterboxed into a swapchain-sized sRGB-encoded
+// image) and the settings menu's layer (premultiplied alpha, sRGB encoded) become the HDR
+// swapchain's signal: HDR10 (BT.2020 primaries, PQ) or scRGB (linear BT.709, 1.0 = 80 nits).
+// SDR white is shown at paper_white; boost expands the game's highlights towards the peak.
+
+#version 450
+
+layout (location = 0) out vec4 color;
+
+layout (binding = 0) uniform sampler2D game;    // the letterboxed SDR frame, swapchain-sized
+layout (binding = 1) uniform sampler2D overlay; // the menu layer (FLAG_OVERLAY)
+
+layout (push_constant) uniform HdrSettings {
+    float paper_white; // nits of SDR white
+    float peak;        // nits the display reaches
+    float boost;       // 0: SDR white at paper white .. 1: SDR white at the peak
+    uint flags;
+} hdr;
+
+const uint FLAG_SCRGB = 1u;   // scRGB output, else HDR10
+const uint FLAG_OVERLAY = 2u; // the menu layer has something drawn
+
+// Linear brightness (SDR white = 1) above which the highlights are expanded: high, so large
+// bright areas (fog, sky) stay near paper white and only lamps, fire and sparks reach the peak.
+const float KNEE = 0.8;
+
+// BT.709 -> BT.2020 primaries (columns).
+const mat3 BT709_TO_BT2020 = mat3(
+    0.6274, 0.0691, 0.0164,
+    0.3293, 0.9195, 0.0880,
+    0.0433, 0.0114, 0.8956);
+
+// The game's picture is made for SDR displays, which show it with a 2.2 power curve. The
+// piecewise sRGB curve (what Windows uses for SDR content in HDR) lifts the shadows: dark
+// scenes turn grey and foggy. Bloodborne is mostly shadows, so 2.2 it is.
+vec3 SdrToLinear(vec3 c) {
+    return pow(max(c, vec3(0.0)), vec3(2.2));
+}
+
+// SMPTE ST 2084 inverse EOTF; y: luminance / 10000 nits.
+vec3 PqEncode(vec3 y) {
+    const float m1 = 0.1593017578125;
+    const float m2 = 78.84375;
+    const float c1 = 0.8359375;
+    const float c2 = 18.8515625;
+    const float c3 = 18.6875;
+    vec3 ym = pow(clamp(y, 0.0, 1.0), vec3(m1));
+    return pow((c1 + c2 * ym) / (1.0 + c3 * ym), vec3(m2));
+}
+
+// Inverse tone map of the brightest channel (hue and saturation kept): unchanged up to KNEE,
+// then a curve with the same slope there that reaches `white` at SDR white.
+vec3 ExpandHighlights(vec3 rgb, float white) {
+    float m = max(rgb.r, max(rgb.g, rgb.b));
+    if (white <= 1.0 || m <= KNEE) {
+        return rgb;
+    }
+    float t = (m - KNEE) / (1.0 - KNEE);
+    float expanded = m + (white - 1.0) * t * t;
+    return rgb * (expanded / m);
+}
+
+void main() {
+    ivec2 pixel = ivec2(gl_FragCoord.xy);
+    vec3 game_srgb = texelFetch(game, pixel, 0).rgb;
+    float white = max(mix(1.0, hdr.peak / hdr.paper_white, clamp(hdr.boost, 0.0, 1.0)), 1.0);
+    vec3 linear = ExpandHighlights(SdrToLinear(game_srgb), white);
+    if ((hdr.flags & FLAG_OVERLAY) != 0u) {
+        // The menu over the frame as the SDR path draws it (blended in sRGB), at paper white:
+        // the menu is not expanded.
+        vec4 menu = texelFetch(overlay, pixel, 0);
+        if (menu.a > 0.0) {
+            vec3 sdr = SdrToLinear(clamp(menu.rgb + game_srgb * (1.0 - menu.a), 0.0, 1.0));
+            linear = mix(linear, sdr, clamp(menu.a * 4.0, 0.0, 1.0));
+        }
+    }
+    if ((hdr.flags & FLAG_SCRGB) != 0u) {
+        color = vec4(linear * (hdr.paper_white / 80.0), 1.0);
+    } else {
+        vec3 nits = max(BT709_TO_BT2020 * linear, vec3(0.0)) * hdr.paper_white;
+        color = vec4(PqEncode(nits / 10000.0), 1.0);
+    }
+}
diff --git a/gpu/shadps4/video_core/renderer_vulkan/host_passes/hdr_pass.cpp b/gpu/shadps4/video_core/renderer_vulkan/host_passes/hdr_pass.cpp
new file mode 100644
index 0000000..23d19db
--- /dev/null
+++ b/gpu/shadps4/video_core/renderer_vulkan/host_passes/hdr_pass.cpp
@@ -0,0 +1,227 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// bbport: HDR output encode pass (hdr_pass.h), modelled on the post-processing pass.
+
+#include "video_core/renderer_vulkan/host_passes/hdr_pass.h"
+
+#include "common/assert.h"
+#include "core/emulator_settings.h"
+#include "video_core/host_shaders/fs_tri_vert.h"
+#include "video_core/host_shaders/hdr_output_frag.h"
+#include "video_core/renderer_vulkan/vk_platform.h"
+#include "video_core/renderer_vulkan/vk_shader_util.h"
+
+#include <array>
+
+namespace Vulkan::HostPasses {
+
+void HdrOutputPass::Create(vk::Device device, vk::Format output_format) {
+    const std::array bindings{
+        vk::DescriptorSetLayoutBinding{
+            .binding = 0,
+            .descriptorType = vk::DescriptorType::eCombinedImageSampler,
+            .descriptorCount = 1,
+            .stageFlags = vk::ShaderStageFlagBits::eFragment,
+        },
+        vk::DescriptorSetLayoutBinding{
+            .binding = 1,
+            .descriptorType = vk::DescriptorType::eCombinedImageSampler,
+            .descriptorCount = 1,
+            .stageFlags = vk::ShaderStageFlagBits::eFragment,
+        },
+    };
+    desc_set_layout = Check<"create HDR output descriptor set layout">(
+        device.createDescriptorSetLayoutUnique(vk::DescriptorSetLayoutCreateInfo{
+            .flags = vk::DescriptorSetLayoutCreateFlagBits::ePushDescriptorKHR,
+            .bindingCount = static_cast<u32>(bindings.size()),
+            .pBindings = bindings.data(),
+        }));
+
+    const vk::PushConstantRange push_constants{
+        .stageFlags = vk::ShaderStageFlagBits::eFragment,
+        .offset = 0,
+        .size = sizeof(Settings),
+    };
+    pipeline_layout = Check<"create HDR output pipeline layout">(
+        device.createPipelineLayoutUnique(vk::PipelineLayoutCreateInfo{
+            .setLayoutCount = 1U,
+            .pSetLayouts = &*desc_set_layout,
+            .pushConstantRangeCount = 1,
+            .pPushConstantRanges = &push_constants,
+        }));
+
+    const auto vs_module = CompileSPV(FS_TRI_VERT, device);
+    ASSERT(vs_module);
+    SetObjectName(device, vs_module, "fs_tri.vert");
+    const auto fs_module = CompileSPV(HDR_OUTPUT_FRAG, device);
+    ASSERT(fs_module);
+    SetObjectName(device, fs_module, "hdr_output.frag");
+
+    const std::array shaders_ci{
+        vk::PipelineShaderStageCreateInfo{
+            .stage = vk::ShaderStageFlagBits::eVertex,
+            .module = vs_module,
+            .pName = "main",
+        },
+        vk::PipelineShaderStageCreateInfo{
+            .stage = vk::ShaderStageFlagBits::eFragment,
+            .module = fs_module,
+            .pName = "main",
+        },
+    };
+
+    const vk::PipelineRenderingCreateInfo pipeline_rendering_ci{
+        .colorAttachmentCount = 1,
+        .pColorAttachmentFormats = &output_format,
+    };
+    const vk::PipelineVertexInputStateCreateInfo vertex_input_info{};
+    const vk::PipelineInputAssemblyStateCreateInfo input_assembly{
+        .topology = vk::PrimitiveTopology::eTriangleList,
+    };
+    const vk::Viewport viewport{
+        .width = 1.0f,
+        .height = 1.0f,
+        .minDepth = 0.0f,
+        .maxDepth = 1.0f,
+    };
+    const vk::Rect2D scissor{.extent = {1, 1}};
+    const vk::PipelineViewportStateCreateInfo viewport_info{
+        .viewportCount = 1,
+        .pViewports = &viewport,
+        .scissorCount = 1,
+        .pScissors = &scissor,
+    };
+    const vk::PipelineRasterizationStateCreateInfo raster_state{
+        .depthClampEnable = false,
+        .rasterizerDiscardEnable = false,
+        .polygonMode = vk::PolygonMode::eFill,
+        .cullMode = vk::CullModeFlagBits::eNone,
+        .frontFace = vk::FrontFace::eClockwise,
+        .depthBiasEnable = false,
+        .lineWidth = 1.0f,
+    };
+    const vk::PipelineMultisampleStateCreateInfo multisampling{
+        .rasterizationSamples = vk::SampleCountFlagBits::e1,
+    };
+    const vk::PipelineColorBlendAttachmentState attachment{
+        .blendEnable = false,
+        .colorWriteMask = vk::ColorComponentFlagBits::eR | vk::ColorComponentFlagBits::eG |
+                          vk::ColorComponentFlagBits::eB | vk::ColorComponentFlagBits::eA,
+    };
+    const vk::PipelineColorBlendStateCreateInfo color_blending{
+        .logicOpEnable = false,
+        .logicOp = vk::LogicOp::eCopy,
+        .attachmentCount = 1,
+        .pAttachments = &attachment,
+    };
+    const std::array dynamic_states{
+        vk::DynamicState::eViewport,
+        vk::DynamicState::eScissor,
+    };
+    const vk::PipelineDynamicStateCreateInfo dynamic_info{
+        .dynamicStateCount = static_cast<u32>(dynamic_states.size()),
+        .pDynamicStates = dynamic_states.data(),
+    };
+    const vk::GraphicsPipelineCreateInfo pipeline_info{
+        .pNext = &pipeline_rendering_ci,
+        .stageCount = static_cast<u32>(shaders_ci.size()),
+        .pStages = shaders_ci.data(),
+        .pVertexInputState = &vertex_input_info,
+        .pInputAssemblyState = &input_assembly,
+        .pViewportState = &viewport_info,
+        .pRasterizationState = &raster_state,
+        .pMultisampleState = &multisampling,
+        .pColorBlendState = &color_blending,
+        .pDynamicState = &dynamic_info,
+        .layout = *pipeline_layout,
+    };
+    pipeline = Check<"create HDR output pipeline">(
+        device.createGraphicsPipelineUnique(/*pipeline_cache*/ {}, pipeline_info));
+
+    device.destroyShaderModule(vs_module);
+    device.destroyShaderModule(fs_module);
+
+    // The shader reads texels (texelFetch); a combined image sampler still needs a sampler.
+    sampler = Check<"create HDR output sampler">(device.createSamplerUnique(vk::SamplerCreateInfo{
+        .magFilter = vk::Filter::eNearest,
+        .minFilter = vk::Filter::eNearest,
+        .mipmapMode = vk::SamplerMipmapMode::eNearest,
+        .addressModeU = vk::SamplerAddressMode::eClampToEdge,
+        .addressModeV = vk::SamplerAddressMode::eClampToEdge,
+        .addressModeW = vk::SamplerAddressMode::eClampToEdge,
+    }));
+}
+
+void HdrOutputPass::Render(vk::CommandBuffer cmdbuf, vk::ImageView game, vk::ImageView overlay,
+                           vk::ImageView output, vk::Extent2D extent, const Settings& settings) {
+    if (EmulatorSettings.IsVkHostMarkersEnabled()) {
+        cmdbuf.beginDebugUtilsLabelEXT(vk::DebugUtilsLabelEXT{
+            .pLabelName = "Host/HDR output",
+        });
+    }
+
+    const std::array image_infos{
+        vk::DescriptorImageInfo{
+            .sampler = *sampler,
+            .imageView = game,
+            .imageLayout = vk::ImageLayout::eShaderReadOnlyOptimal,
+        },
+        vk::DescriptorImageInfo{
+            .sampler = *sampler,
+            .imageView = overlay,
+            .imageLayout = vk::ImageLayout::eShaderReadOnlyOptimal,
+        },
+    };
+    const std::array set_writes{
+        vk::WriteDescriptorSet{
+            .dstSet = VK_NULL_HANDLE,
+            .dstBinding = 0,
+            .dstArrayElement = 0,
+            .descriptorCount = 1,
+            .descriptorType = vk::DescriptorType::eCombinedImageSampler,
+            .pImageInfo = &image_infos[0],
+        },
+        vk::WriteDescriptorSet{
+            .dstSet = VK_NULL_HANDLE,
+            .dstBinding = 1,
+            .dstArrayElement = 0,
+            .descriptorCount = 1,
+            .descriptorType = vk::DescriptorType::eCombinedImageSampler,
+            .pImageInfo = &image_infos[1],
+        },
+    };
+
+    const vk::RenderingAttachmentInfo attachment{
+        .imageView = output,
+        .imageLayout = vk::ImageLayout::eColorAttachmentOptimal,
+        // Every pixel is written by the full-screen triangle.
+        .loadOp = vk::AttachmentLoadOp::eDontCare,
+        .storeOp = vk::AttachmentStoreOp::eStore,
+    };
+    const vk::RenderingInfo rendering_info{
+        .renderArea = {.extent = extent},
+        .layerCount = 1,
+        .colorAttachmentCount = 1,
+        .pColorAttachments = &attachment,
+    };
+
+    cmdbuf.bindPipeline(vk::PipelineBindPoint::eGraphics, *pipeline);
+    cmdbuf.setViewport(0, vk::Viewport{
+                              .width = static_cast<float>(extent.width),
+                              .height = static_cast<float>(extent.height),
+                              .minDepth = 0.0f,
+                              .maxDepth = 1.0f,
+                          });
+    cmdbuf.setScissor(0, vk::Rect2D{.extent = extent});
+    cmdbuf.pushDescriptorSetKHR(vk::PipelineBindPoint::eGraphics, *pipeline_layout, 0, set_writes);
+    cmdbuf.pushConstants(*pipeline_layout, vk::ShaderStageFlagBits::eFragment, 0,
+                         sizeof(Settings), &settings);
+    cmdbuf.beginRendering(rendering_info);
+    cmdbuf.draw(3, 1, 0, 0);
+    cmdbuf.endRendering();
+
+    if (EmulatorSettings.IsVkHostMarkersEnabled()) {
+        cmdbuf.endDebugUtilsLabelEXT();
+    }
+}
+
+} // namespace Vulkan::HostPasses
