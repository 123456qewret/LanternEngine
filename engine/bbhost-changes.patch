diff --git a/src/respawn_patch.h b/src/respawn_patch.h
new file mode 100644
index 0000000..c73a186
--- /dev/null
+++ b/src/respawn_patch.h
@@ -0,0 +1,53 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later
+ * Removes the 12-second minimum loading time after the player dies (CUSA03173 1.09).
+ * Ported from AwesomeObserver/bloodborne_pc 149972b, "Remove death-triggered minimum
+ * loading delay on Windows" (Evgeniy Doronin).
+ *
+ * The player-death flag initializes a minimum loading countdown to 12.0 seconds; the
+ * world-loading step waits on it independently of character readiness. Only that
+ * initialization changes (vmovss xmm0,[12.0] -> vxorps xmm0,xmm0,xmm0 + nop, 8 bytes).
+ * The character readiness branch, the resource-loading steps and the 15-second multiplayer
+ * timeout stay intact. Nothing is written unless the whole init block, the readiness branch
+ * and the 12.0 constant match byte for byte. Offsets refer to the loaded image, not to
+ * SELF/ELF file offsets. BB_RESPAWN_DELAY_FIX=0 keeps the original delay (probe.c).
+ */
+#ifndef BB_RESPAWN_PATCH_H
+#define BB_RESPAWN_PATCH_H
+
+#include <stddef.h>
+#include <string.h>
+
+enum { BB_RESPAWN_UNSUPPORTED, BB_RESPAWN_APPLIED, BB_RESPAWN_ALREADY_APPLIED };
+
+static inline int bb_patch_respawn_delay(unsigned char *image, size_t size) {
+    static const unsigned char init[] = {
+        0x41,0x80,0xbc,0x24,0xe4,0x00,0x00,0x00,0x00, /* cmp byte [r12+0xe4],0 */
+        0x74,0x0a,                                    /* je +10 */
+        0xc5,0xfa,0x10,0x05,0x5c,0xf5,0xfe,0x02,      /* vmovss xmm0,[rip+..] (12.0) */
+        0xeb,0x04,0xc5,0xf8,0x57,0xc0,                /* jmp +4; vxorps xmm0,xmm0,xmm0 */
+        0xc4,0xc1,0x7a,0x11,0x84,0x24,0x78,0x02,0x00,0x00, /* countdown = xmm0 */
+        0x41,0xc7,0x84,0x24,0x7c,0x02,0x00,0x00,0x00,0x00,0x70,0x41 /* 15 s timeout */
+    };
+    static const unsigned char ready[] = {
+        0xc5,0xf8,0x2e,0xca,0x0f,0x87,0x53,0x06,0x00,0x00,
+        0x45,0x84,0xff,0x0f,0x84,0x4a,0x06,0x00,0x00
+    };
+    static const unsigned char twelve[] = {0x00,0x00,0x40,0x41};
+    static const unsigned char zero[] = {0xc5,0xf8,0x57,0xc0,0x0f,0x1f,0x40,0x00};
+    const size_t init_at = 0x1938b59, instruction_at = 0x1938b64;
+    const size_t twelve_at = 0x49280c8, ready_at = 0x193a581;
+    unsigned char expected[sizeof(init)];
+    if (!image || size < twelve_at + sizeof(twelve)) return BB_RESPAWN_UNSUPPORTED;
+    if (memcmp(image + twelve_at, twelve, sizeof(twelve)) ||
+        memcmp(image + ready_at, ready, sizeof(ready))) return BB_RESPAWN_UNSUPPORTED;
+    if (!memcmp(image + init_at, init, sizeof(init))) {
+        memcpy(image + instruction_at, zero, sizeof(zero));
+        return BB_RESPAWN_APPLIED;
+    }
+    memcpy(expected, init, sizeof(init));
+    memcpy(expected + (instruction_at - init_at), zero, sizeof(zero));
+    return !memcmp(image + init_at, expected, sizeof(expected)) ?
+        BB_RESPAWN_ALREADY_APPLIED : BB_RESPAWN_UNSUPPORTED;
+}
+
+#endif
diff --git a/tests/test_hdr_native.cpp b/tests/test_hdr_native.cpp
new file mode 100644
index 0000000..d15f7f5
--- /dev/null
+++ b/tests/test_hdr_native.cpp
@@ -0,0 +1,848 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// Runs native HDR output's shaders (hdr_native.comp, docs/hdr.md) on a synthetic frame: a scene
+// with midtones, a highlight 8x brighter than SDR white, NaN/inf texels, bloom (SDR brighter than
+// the scene) and UI drawn after the snapshot, tonemapped by a known curve. Checks the half-size
+// luma, the exposure estimate (and its resistance to bloom), and the gain map: exactly 1 below
+// the knee and on UI, the scene's ratio (to the power of the strength, into the peak) on the
+// highlight. Plain Vulkan 1.3 compute; Lavapipe works.
+#include <vulkan/vulkan.h>
+
+#include <algorithm>
+#include <array>
+#include <cassert>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <limits>
+#include <vector>
+
+#include "video_core/host_shaders/hdr_native_exposure_comp.h"
+#include "video_core/host_shaders/hdr_native_gain_comp.h"
+#include "video_core/host_shaders/hdr_native_luma_comp.h"
+#include "video_core/host_shaders/hdr_native_snapshot_comp.h"
+#include "video_core/host_shaders/hdr_native_stats_comp.h"
+
+namespace {
+
+#define CHECK(call)                                                                               \
+    do {                                                                                          \
+        const VkResult result_ = (call);                                                          \
+        if (result_ != VK_SUCCESS) {                                                              \
+            std::fprintf(stderr, "%s failed: %d\n", #call, int(result_));                         \
+            std::exit(1);                                                                         \
+        }                                                                                         \
+    } while (0)
+
+constexpr uint32_t W = 64, H = 32;     // the frame (the UI target)
+constexpr uint32_t LW = W / 2, LH = H / 2; // the luma
+constexpr float Exposure = 0.25f;      // the game's exposure in the synthetic tonemap
+constexpr float Knee = 0.5f;           // vk_hdr_native.cpp
+
+uint16_t ToHalf(float value) {
+    if (std::isnan(value)) {
+        return 0x7e00;
+    }
+    if (std::isinf(value)) {
+        return value > 0 ? 0x7c00 : 0xfc00;
+    }
+    uint32_t bits;
+    std::memcpy(&bits, &value, 4);
+    const uint32_t sign = (bits >> 16) & 0x8000;
+    const int exponent = int((bits >> 23) & 0xff) - 127 + 15;
+    uint32_t mantissa = bits & 0x7fffff;
+    if (exponent >= 31) {
+        return uint16_t(sign | 0x7c00);
+    }
+    if (exponent <= 0) {
+        if (exponent < -10) {
+            return uint16_t(sign);
+        }
+        mantissa |= 0x800000;
+        const int shift = 14 - exponent;
+        return uint16_t(sign | ((mantissa + (1u << (shift - 1))) >> shift));
+    }
+    const uint32_t rounded = (uint32_t(exponent) << 10 | mantissa >> 13) + ((mantissa >> 12) & 1);
+    return uint16_t(sign | rounded);
+}
+
+float FromHalf(uint16_t v) {
+    const int exponent = (v >> 10) & 31;
+    const float mantissa = float(v & 1023);
+    const float sign = v & 0x8000 ? -1.0f : 1.0f;
+    if (exponent == 31) {
+        return mantissa ? std::numeric_limits<float>::quiet_NaN()
+                        : sign * std::numeric_limits<float>::infinity();
+    }
+    return sign * (exponent == 0 ? std::ldexp(mantissa, -24)
+                                 : std::ldexp(1.0f + mantissa / 1024.0f, exponent - 15));
+}
+
+// The synthetic game's tonemap: the exposure, linear up to 0.5, then a shoulder into SDR white;
+// display-encoded with 2.2 into 8 bits.
+float Curve(float x) {
+    return x <= 0.5f ? x : 0.5f + 0.5f * (1.0f - std::exp(-(x - 0.5f) / 0.5f));
+}
+uint8_t Encode(float linear) {
+    return uint8_t(std::lround(std::pow(std::clamp(linear, 0.0f, 1.0f), 1.0f / 2.2f) * 255.0f));
+}
+
+struct Vk {
+    VkInstance instance{};
+    VkPhysicalDevice physical{};
+    VkDevice device{};
+    VkQueue queue{};
+    uint32_t family = 0;
+    VkCommandPool pool{};
+    VkCommandBuffer cmd{};
+    VkPhysicalDeviceMemoryProperties memory{};
+
+    uint32_t MemoryType(uint32_t bits, VkMemoryPropertyFlags flags) const {
+        for (uint32_t i = 0; i < memory.memoryTypeCount; ++i) {
+            if ((bits & (1u << i)) && (memory.memoryTypes[i].propertyFlags & flags) == flags) {
+                return i;
+            }
+        }
+        std::fprintf(stderr, "no memory type\n");
+        std::exit(1);
+    }
+};
+
+struct Image {
+    VkImage image{};
+    VkDeviceMemory memory{};
+    VkImageView view{};
+    VkFormat format{};
+    uint32_t width = 0, height = 0, bytes = 0;
+};
+
+struct Buffer {
+    VkBuffer buffer{};
+    VkDeviceMemory memory{};
+    void* mapped = nullptr;
+    VkDeviceSize size = 0;
+};
+
+Image MakeImage(const Vk& vk, VkFormat format, uint32_t width, uint32_t height, uint32_t bytes) {
+    Image image{.format = format, .width = width, .height = height, .bytes = bytes};
+    const VkImageCreateInfo info{
+        .sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO,
+        .imageType = VK_IMAGE_TYPE_2D,
+        .format = format,
+        .extent = {width, height, 1},
+        .mipLevels = 1,
+        .arrayLayers = 1,
+        .samples = VK_SAMPLE_COUNT_1_BIT,
+        .tiling = VK_IMAGE_TILING_OPTIMAL,
+        .usage = VK_IMAGE_USAGE_STORAGE_BIT | VK_IMAGE_USAGE_SAMPLED_BIT |
+                 VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT,
+        .initialLayout = VK_IMAGE_LAYOUT_UNDEFINED,
+    };
+    CHECK(vkCreateImage(vk.device, &info, nullptr, &image.image));
+    VkMemoryRequirements requirements;
+    vkGetImageMemoryRequirements(vk.device, image.image, &requirements);
+    const VkMemoryAllocateInfo alloc{
+        .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+        .allocationSize = requirements.size,
+        .memoryTypeIndex =
+            vk.MemoryType(requirements.memoryTypeBits, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT),
+    };
+    CHECK(vkAllocateMemory(vk.device, &alloc, nullptr, &image.memory));
+    CHECK(vkBindImageMemory(vk.device, image.image, image.memory, 0));
+    const VkImageViewCreateInfo view{
+        .sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO,
+        .image = image.image,
+        .viewType = VK_IMAGE_VIEW_TYPE_2D,
+        .format = format,
+        .subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1},
+    };
+    CHECK(vkCreateImageView(vk.device, &view, nullptr, &image.view));
+    return image;
+}
+
+Buffer MakeBuffer(const Vk& vk, VkDeviceSize size, VkBufferUsageFlags usage, bool host = true) {
+    Buffer buffer{.size = size};
+    const VkBufferCreateInfo info{
+        .sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO,
+        .size = size,
+        .usage = usage,
+    };
+    CHECK(vkCreateBuffer(vk.device, &info, nullptr, &buffer.buffer));
+    VkMemoryRequirements requirements;
+    vkGetBufferMemoryRequirements(vk.device, buffer.buffer, &requirements);
+    const VkMemoryAllocateInfo alloc{
+        .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+        .allocationSize = requirements.size,
+        .memoryTypeIndex = vk.MemoryType(requirements.memoryTypeBits,
+                                         host ? VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT |
+                                                    VK_MEMORY_PROPERTY_HOST_COHERENT_BIT
+                                              : VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT),
+    };
+    CHECK(vkAllocateMemory(vk.device, &alloc, nullptr, &buffer.memory));
+    CHECK(vkBindBufferMemory(vk.device, buffer.buffer, buffer.memory, 0));
+    if (host) {
+        CHECK(vkMapMemory(vk.device, buffer.memory, 0, VK_WHOLE_SIZE, 0, &buffer.mapped));
+    }
+    return buffer;
+}
+
+struct Pass {
+    VkDescriptorSetLayout set_layout{};
+    VkPipelineLayout layout{};
+    VkPipeline pipeline{};
+    VkDescriptorSet set{};
+    std::vector<VkDescriptorType> types;
+};
+
+Pass MakePass(const Vk& vk, VkDescriptorPool pool, std::vector<VkDescriptorType> types,
+              uint32_t push_size, const uint32_t* code, size_t code_size) {
+    Pass pass{.types = types};
+    std::vector<VkDescriptorSetLayoutBinding> bindings;
+    for (uint32_t i = 0; i < types.size(); ++i) {
+        bindings.push_back({i, types[i], 1, VK_SHADER_STAGE_COMPUTE_BIT, nullptr});
+    }
+    const VkDescriptorSetLayoutCreateInfo set_info{
+        .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO,
+        .bindingCount = uint32_t(bindings.size()),
+        .pBindings = bindings.data(),
+    };
+    CHECK(vkCreateDescriptorSetLayout(vk.device, &set_info, nullptr, &pass.set_layout));
+    const VkPushConstantRange push{VK_SHADER_STAGE_COMPUTE_BIT, 0, push_size};
+    const VkPipelineLayoutCreateInfo layout_info{
+        .sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO,
+        .setLayoutCount = 1,
+        .pSetLayouts = &pass.set_layout,
+        .pushConstantRangeCount = push_size ? 1u : 0u,
+        .pPushConstantRanges = push_size ? &push : nullptr,
+    };
+    CHECK(vkCreatePipelineLayout(vk.device, &layout_info, nullptr, &pass.layout));
+    const VkShaderModuleCreateInfo module_info{
+        .sType = VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO,
+        .codeSize = code_size,
+        .pCode = code,
+    };
+    VkShaderModule module;
+    CHECK(vkCreateShaderModule(vk.device, &module_info, nullptr, &module));
+    const VkComputePipelineCreateInfo pipeline_info{
+        .sType = VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO,
+        .stage = {.sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO,
+                  .stage = VK_SHADER_STAGE_COMPUTE_BIT,
+                  .module = module,
+                  .pName = "main"},
+        .layout = pass.layout,
+    };
+    CHECK(vkCreateComputePipelines(vk.device, VK_NULL_HANDLE, 1, &pipeline_info, nullptr,
+                                   &pass.pipeline));
+    vkDestroyShaderModule(vk.device, module, nullptr);
+    const VkDescriptorSetAllocateInfo alloc{
+        .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO,
+        .descriptorPool = pool,
+        .descriptorSetCount = 1,
+        .pSetLayouts = &pass.set_layout,
+    };
+    CHECK(vkAllocateDescriptorSets(vk.device, &alloc, &pass.set));
+    return pass;
+}
+
+// A resource of a pass: an image (sampled or storage, General layout) or a whole buffer.
+struct Resource {
+    const Image* image = nullptr;
+    const Buffer* buffer = nullptr;
+};
+
+void Bind(const Vk& vk, const Pass& pass, std::vector<Resource> resources) {
+    std::vector<VkDescriptorImageInfo> images(resources.size());
+    std::vector<VkDescriptorBufferInfo> buffers(resources.size());
+    std::vector<VkWriteDescriptorSet> writes;
+    for (uint32_t i = 0; i < resources.size(); ++i) {
+        VkWriteDescriptorSet write{
+            .sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET,
+            .dstSet = pass.set,
+            .dstBinding = i,
+            .descriptorCount = 1,
+            .descriptorType = pass.types[i],
+        };
+        if (resources[i].image) {
+            images[i] = {VK_NULL_HANDLE, resources[i].image->view, VK_IMAGE_LAYOUT_GENERAL};
+            write.pImageInfo = &images[i];
+        } else {
+            buffers[i] = {resources[i].buffer->buffer, 0, VK_WHOLE_SIZE};
+            write.pBufferInfo = &buffers[i];
+        }
+        writes.push_back(write);
+    }
+    vkUpdateDescriptorSets(vk.device, uint32_t(writes.size()), writes.data(), 0, nullptr);
+}
+
+void Barrier(VkCommandBuffer cmd) {
+    const VkMemoryBarrier barrier{
+        .sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER,
+        .srcAccessMask = VK_ACCESS_MEMORY_WRITE_BIT,
+        .dstAccessMask = VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT,
+    };
+    vkCmdPipelineBarrier(cmd, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+                         VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, 1, &barrier, 0, nullptr, 0,
+                         nullptr);
+}
+
+void Dispatch(VkCommandBuffer cmd, const Pass& pass, const void* push, uint32_t push_size,
+              uint32_t x, uint32_t y) {
+    vkCmdBindPipeline(cmd, VK_PIPELINE_BIND_POINT_COMPUTE, pass.pipeline);
+    vkCmdBindDescriptorSets(cmd, VK_PIPELINE_BIND_POINT_COMPUTE, pass.layout, 0, 1, &pass.set, 0,
+                            nullptr);
+    if (push_size) {
+        vkCmdPushConstants(cmd, pass.layout, VK_SHADER_STAGE_COMPUTE_BIT, 0, push_size, push);
+    }
+    vkCmdDispatch(cmd, x, y, 1);
+    Barrier(cmd);
+}
+
+void Begin(const Vk& vk) {
+    CHECK(vkResetCommandBuffer(vk.cmd, 0));
+    const VkCommandBufferBeginInfo begin{
+        .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO,
+        .flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT,
+    };
+    CHECK(vkBeginCommandBuffer(vk.cmd, &begin));
+}
+
+void Submit(const Vk& vk) {
+    CHECK(vkEndCommandBuffer(vk.cmd));
+    const VkSubmitInfo submit{
+        .sType = VK_STRUCTURE_TYPE_SUBMIT_INFO,
+        .commandBufferCount = 1,
+        .pCommandBuffers = &vk.cmd,
+    };
+    CHECK(vkQueueSubmit(vk.queue, 1, &submit, VK_NULL_HANDLE));
+    CHECK(vkQueueWaitIdle(vk.queue));
+}
+
+void Upload(const Vk& vk, const Buffer& staging, const Image& image, const void* data) {
+    std::memcpy(staging.mapped, data, size_t(image.width) * image.height * image.bytes);
+    Begin(vk);
+    const VkBufferImageCopy region{
+        .imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1},
+        .imageExtent = {image.width, image.height, 1},
+    };
+    vkCmdCopyBufferToImage(vk.cmd, staging.buffer, image.image, VK_IMAGE_LAYOUT_GENERAL, 1,
+                           &region);
+    Barrier(vk.cmd);
+    Submit(vk);
+}
+
+template <typename T>
+std::vector<T> Download(const Vk& vk, const Buffer& staging, const Image& image) {
+    Begin(vk);
+    const VkBufferImageCopy region{
+        .imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1},
+        .imageExtent = {image.width, image.height, 1},
+    };
+    vkCmdCopyImageToBuffer(vk.cmd, image.image, VK_IMAGE_LAYOUT_GENERAL, staging.buffer, 1,
+                           &region);
+    Barrier(vk.cmd);
+    Submit(vk);
+    std::vector<T> out(size_t(image.width) * image.height * image.bytes / sizeof(T));
+    std::memcpy(out.data(), staging.mapped, out.size() * sizeof(T));
+    return out;
+}
+
+Vk Init() {
+    Vk vk;
+    const VkApplicationInfo app{
+        .sType = VK_STRUCTURE_TYPE_APPLICATION_INFO,
+        .pApplicationName = "hdr-native-shader-test",
+        .apiVersion = VK_API_VERSION_1_3,
+    };
+    const VkInstanceCreateInfo instance_info{
+        .sType = VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO,
+        .pApplicationInfo = &app,
+    };
+    CHECK(vkCreateInstance(&instance_info, nullptr, &vk.instance));
+    uint32_t count = 0;
+    CHECK(vkEnumeratePhysicalDevices(vk.instance, &count, nullptr));
+    std::vector<VkPhysicalDevice> devices(count);
+    CHECK(vkEnumeratePhysicalDevices(vk.instance, &count, devices.data()));
+    // BB_TEST_GPU=<index> picks a device; else the first that has Vulkan 1.3.
+    const char* wanted = std::getenv("BB_TEST_GPU");
+    for (uint32_t i = 0; i < count && !vk.physical; ++i) {
+        VkPhysicalDeviceProperties properties;
+        vkGetPhysicalDeviceProperties(devices[i], &properties);
+        if ((wanted && uint32_t(std::atoi(wanted)) != i) ||
+            properties.apiVersion < VK_API_VERSION_1_3) {
+            continue;
+        }
+        vk.physical = devices[i];
+        std::printf("HDR native shaders: %s\n", properties.deviceName);
+    }
+    assert(vk.physical);
+    vkGetPhysicalDeviceMemoryProperties(vk.physical, &vk.memory);
+    uint32_t families = 0;
+    vkGetPhysicalDeviceQueueFamilyProperties(vk.physical, &families, nullptr);
+    std::vector<VkQueueFamilyProperties> family_properties(families);
+    vkGetPhysicalDeviceQueueFamilyProperties(vk.physical, &families, family_properties.data());
+    while (!(family_properties[vk.family].queueFlags & VK_QUEUE_COMPUTE_BIT)) {
+        ++vk.family;
+    }
+    VkPhysicalDeviceFeatures supported;
+    vkGetPhysicalDeviceFeatures(vk.physical, &supported);
+    assert(supported.shaderStorageImageExtendedFormats); // rg16f / r16f storage
+    const VkPhysicalDeviceFeatures features{.shaderStorageImageExtendedFormats = VK_TRUE};
+    const float priority = 1.0f;
+    const VkDeviceQueueCreateInfo queue_info{
+        .sType = VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO,
+        .queueFamilyIndex = vk.family,
+        .queueCount = 1,
+        .pQueuePriorities = &priority,
+    };
+    const VkDeviceCreateInfo device_info{
+        .sType = VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO,
+        .queueCreateInfoCount = 1,
+        .pQueueCreateInfos = &queue_info,
+        .pEnabledFeatures = &features,
+    };
+    CHECK(vkCreateDevice(vk.physical, &device_info, nullptr, &vk.device));
+    vkGetDeviceQueue(vk.device, vk.family, 0, &vk.queue);
+    const VkCommandPoolCreateInfo pool_info{
+        .sType = VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO,
+        .flags = VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT,
+        .queueFamilyIndex = vk.family,
+    };
+    CHECK(vkCreateCommandPool(vk.device, &pool_info, nullptr, &vk.pool));
+    const VkCommandBufferAllocateInfo cmd_info{
+        .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO,
+        .commandPool = vk.pool,
+        .level = VK_COMMAND_BUFFER_LEVEL_PRIMARY,
+        .commandBufferCount = 1,
+    };
+    CHECK(vkAllocateCommandBuffers(vk.device, &cmd_info, &vk.cmd));
+    return vk;
+}
+
+struct ExposureState {
+    float log_scale, valid, samples, frames;
+};
+
+// --bench [width height]: GPU time of one frame's passes (luma, snapshot + statistics,
+// exposure, gain map; barriers between them as in the game) on noise-filled images.
+void Bench(const Vk& vk, const Pass& luma, const Pass& snapshot, const Pass& exposure,
+           const Pass& gain, uint32_t width, uint32_t height) {
+    const Image scene = MakeImage(vk, VK_FORMAT_R16G16B16A16_SFLOAT, width, height, 8);
+    const Image luma_image =
+        MakeImage(vk, VK_FORMAT_R16G16_SFLOAT, (width + 1) / 2, (height + 1) / 2, 4);
+    const Image target = MakeImage(vk, VK_FORMAT_R8G8B8A8_UNORM, width, height, 4);
+    const Image copy = MakeImage(vk, VK_FORMAT_R8G8B8A8_UNORM, width, height, 4);
+    const Image gain_map = MakeImage(vk, VK_FORMAT_R16_SFLOAT, width, height, 2);
+    const uint32_t groups_x = (width + 15) / 16, groups_y = (height + 15) / 16;
+    // In video memory, as the game's (VMA_MEMORY_USAGE_AUTO_PREFER_DEVICE).
+    const Buffer partials =
+        MakeBuffer(vk, groups_x * groups_y * 16, VK_BUFFER_USAGE_STORAGE_BUFFER_BIT, false);
+    const Buffer state = MakeBuffer(vk, sizeof(ExposureState),
+                                    VK_BUFFER_USAGE_STORAGE_BUFFER_BIT |
+                                        VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+                                    false);
+    const Buffer staging = MakeBuffer(vk, VkDeviceSize(width) * height * 8,
+                                      VK_BUFFER_USAGE_TRANSFER_SRC_BIT);
+    Begin(vk);
+    vkCmdFillBuffer(vk.cmd, state.buffer, 0, VK_WHOLE_SIZE, 0);
+    Barrier(vk.cmd);
+    std::vector<VkImageMemoryBarrier> to_general;
+    for (const Image* image : {&scene, &luma_image, &target, &copy, &gain_map}) {
+        to_general.push_back({.sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+                              .dstAccessMask = VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT,
+                              .oldLayout = VK_IMAGE_LAYOUT_UNDEFINED,
+                              .newLayout = VK_IMAGE_LAYOUT_GENERAL,
+                              .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+                              .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+                              .image = image->image,
+                              .subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1}});
+    }
+    vkCmdPipelineBarrier(vk.cmd, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT,
+                         VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, 0, nullptr, 0, nullptr,
+                         uint32_t(to_general.size()), to_general.data());
+    Submit(vk);
+    // Noise, so that no compression of uniform surfaces makes the reads cheaper than in game.
+    uint32_t seed = 12345;
+    const auto next = [&seed] {
+        seed = seed * 1664525u + 1013904223u;
+        return seed >> 8;
+    };
+    std::vector<uint16_t> scene_data(size_t(width) * height * 4);
+    for (auto& v : scene_data) {
+        v = ToHalf(float(next() % 4096) / 512.0f);
+    }
+    Upload(vk, staging, scene, scene_data.data());
+    std::vector<uint8_t> frame_data(size_t(width) * height * 4);
+    for (auto& v : frame_data) {
+        v = uint8_t(next());
+    }
+    Upload(vk, staging, target, frame_data.data());
+    Bind(vk, luma, {{&scene}, {&luma_image}});
+    Bind(vk, snapshot, {{&target}, {&luma_image}, {nullptr, &partials}, {nullptr, &state},
+                        {&copy}});
+    Bind(vk, exposure, {{nullptr, &partials}, {nullptr, &state}});
+    Bind(vk, gain, {{&target}, {&copy}, {&luma_image}, {nullptr, &state}, {&gain_map}});
+    VkQueryPool queries;
+    const VkQueryPoolCreateInfo query_info{
+        .sType = VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO,
+        .queryType = VK_QUERY_TYPE_TIMESTAMP,
+        .queryCount = 2,
+    };
+    CHECK(vkCreateQueryPool(vk.device, &query_info, nullptr, &queries));
+    VkPhysicalDeviceProperties properties;
+    vkGetPhysicalDeviceProperties(vk.physical, &properties);
+    const uint32_t reset = 0;
+    const struct {
+        uint32_t count, reset;
+        float min_samples, rate;
+    } exposure_params{groups_x * groups_y, 0, 1024.0f, 0.1f};
+    const struct {
+        float strength, white, knee, unused;
+    } gain_params{0.5f, 5.0f, Knee, 0.0f};
+    std::vector<double> times;
+    for (int run = 0; run < 120; ++run) {
+        Begin(vk);
+        vkCmdResetQueryPool(vk.cmd, queries, 0, 2);
+        vkCmdWriteTimestamp(vk.cmd, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, queries, 0);
+        Dispatch(vk.cmd, luma, nullptr, 0, (luma_image.width + 7) / 8, (luma_image.height + 7) / 8);
+        Dispatch(vk.cmd, snapshot, &reset, 4, groups_x, groups_y);
+        Dispatch(vk.cmd, exposure, &exposure_params, sizeof(exposure_params), 1, 1);
+        Dispatch(vk.cmd, gain, &gain_params, sizeof(gain_params), (width + 7) / 8,
+                 (height + 7) / 8);
+        vkCmdWriteTimestamp(vk.cmd, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, queries, 1);
+        Submit(vk);
+        std::array<uint64_t, 2> stamps{};
+        CHECK(vkGetQueryPoolResults(vk.device, queries, 0, 2, sizeof(stamps), stamps.data(), 8,
+                                    VK_QUERY_RESULT_64_BIT | VK_QUERY_RESULT_WAIT_BIT));
+        if (run >= 20) { // warm-up (clocks, caches)
+            times.push_back(double(stamps[1] - stamps[0]) * properties.limits.timestampPeriod /
+                            1e6);
+        }
+    }
+    std::sort(times.begin(), times.end());
+    std::printf("HDR native shaders: %ux%u, all passes: median %.3f ms, min %.3f ms, p90 %.3f ms\n",
+                width, height, times[times.size() / 2], times.front(),
+                times[times.size() * 9 / 10]);
+    vkDestroyQueryPool(vk.device, queries, nullptr);
+}
+
+} // namespace
+
+int main(int argc, char** argv) {
+    Vk vk = Init();
+    VkDescriptorPool pool;
+    const std::array<VkDescriptorPoolSize, 3> sizes{{
+        {VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE, 16},
+        {VK_DESCRIPTOR_TYPE_STORAGE_IMAGE, 8},
+        {VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 16},
+    }};
+    const VkDescriptorPoolCreateInfo pool_info{
+        .sType = VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO,
+        .maxSets = 8,
+        .poolSizeCount = uint32_t(sizes.size()),
+        .pPoolSizes = sizes.data(),
+    };
+    CHECK(vkCreateDescriptorPool(vk.device, &pool_info, nullptr, &pool));
+    constexpr auto Sampled = VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE;
+    constexpr auto Storage = VK_DESCRIPTOR_TYPE_STORAGE_IMAGE;
+    constexpr auto Ssbo = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+    // The same layouts as HdrNative::CreatePipelines.
+    const Pass luma = MakePass(vk, pool, {Sampled, Storage}, 0, HDR_NATIVE_LUMA_COMP,
+                               sizeof(HDR_NATIVE_LUMA_COMP));
+    const Pass stats = MakePass(vk, pool, {Sampled, Sampled, Ssbo, Ssbo}, 4,
+                                HDR_NATIVE_STATS_COMP, sizeof(HDR_NATIVE_STATS_COMP));
+    const Pass snapshot = MakePass(vk, pool, {Sampled, Sampled, Ssbo, Ssbo, Storage}, 4,
+                                   HDR_NATIVE_SNAPSHOT_COMP, sizeof(HDR_NATIVE_SNAPSHOT_COMP));
+    const Pass exposure = MakePass(vk, pool, {Ssbo, Ssbo}, 16, HDR_NATIVE_EXPOSURE_COMP,
+                                   sizeof(HDR_NATIVE_EXPOSURE_COMP));
+    const Pass gain = MakePass(vk, pool, {Sampled, Sampled, Sampled, Ssbo, Storage}, 16,
+                               HDR_NATIVE_GAIN_COMP, sizeof(HDR_NATIVE_GAIN_COMP));
+    if (argc > 1 && std::strcmp(argv[1], "--bench") == 0) {
+        const uint32_t width = argc > 3 ? uint32_t(std::atoi(argv[2])) : 1920;
+        const uint32_t height = argc > 3 ? uint32_t(std::atoi(argv[3])) : 1080;
+        Bench(vk, luma, snapshot, exposure, gain, width, height);
+        vkDeviceWaitIdle(vk.device);
+        return 0;
+    }
+
+    const Image scene = MakeImage(vk, VK_FORMAT_R16G16B16A16_SFLOAT, W, H, 8);
+    const Image luma_image = MakeImage(vk, VK_FORMAT_R16G16_SFLOAT, LW, LH, 4);
+    const Image target = MakeImage(vk, VK_FORMAT_R8G8B8A8_UNORM, W, H, 4); // the UI target
+    const Image copy = MakeImage(vk, VK_FORMAT_R8G8B8A8_UNORM, W, H, 4);
+    const Image gain_map = MakeImage(vk, VK_FORMAT_R16_SFLOAT, W, H, 2);
+    const uint32_t groups_x = (W + 15) / 16, groups_y = (H + 15) / 16;
+    const Buffer partials = MakeBuffer(vk, groups_x * groups_y * 16, VK_BUFFER_USAGE_STORAGE_BUFFER_BIT);
+    const Buffer state = MakeBuffer(vk, sizeof(ExposureState), VK_BUFFER_USAGE_STORAGE_BUFFER_BIT);
+    const Buffer staging = MakeBuffer(vk, W * H * 8, VK_BUFFER_USAGE_TRANSFER_SRC_BIT |
+                                                          VK_BUFFER_USAGE_TRANSFER_DST_BIT);
+    std::memset(state.mapped, 0, sizeof(ExposureState));
+    Begin(vk);
+    std::vector<VkImageMemoryBarrier> to_general;
+    for (const Image* image : {&scene, &luma_image, &target, &copy, &gain_map}) {
+        to_general.push_back({.sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+                              .dstAccessMask = VK_ACCESS_MEMORY_READ_BIT | VK_ACCESS_MEMORY_WRITE_BIT,
+                              .oldLayout = VK_IMAGE_LAYOUT_UNDEFINED,
+                              .newLayout = VK_IMAGE_LAYOUT_GENERAL,
+                              .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+                              .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+                              .image = image->image,
+                              .subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1}});
+    }
+    vkCmdPipelineBarrier(vk.cmd, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT,
+                         VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, 0, nullptr, 0, nullptr,
+                         uint32_t(to_general.size()), to_general.data());
+    Submit(vk);
+
+    // The scene (linear HDR, the game's units) and what the game makes of it.
+    enum Kind { Mid, Light, Bloom, Glow, Dark };
+    std::vector<Kind> kinds(W * H);
+    std::vector<float> scene_rgb(W * H * 3);
+    std::vector<uint16_t> scene_half(W * H * 4);
+    std::vector<uint8_t> before_ui(W * H * 4);
+    for (uint32_t y = 0; y < H; ++y) {
+        for (uint32_t x = 0; x < W; ++x) {
+            const uint32_t p = y * W + x;
+            // Midtones on the SDR scale from 0.03 to 0.4 (a gradient), a warm light at 8x SDR
+            // white (an 8x8 block), around it bloom (added after the scene color: a dark scene
+            // under a brighter SDR frame): bright next to the light, in the midtones further out.
+            Kind kind = Mid;
+            float level = (0.03f + 0.37f * float(x) / float(W - 1)) / Exposure;
+            std::array<float, 3> tint{1.0f, 1.0f, 1.0f};
+            if (x >= 40 && x < 48 && y >= 8 && y < 16) {
+                kind = Light;
+                level = 8.0f / Exposure;
+                tint = {1.0f, 0.8f, 0.5f};
+            } else if (x >= 38 && x < 50 && y >= 6 && y < 18) {
+                kind = Bloom;
+                level = 0.02f / Exposure;
+            } else if (x >= 36 && x < 52 && y >= 4 && y < 20) {
+                kind = Glow;
+                level = 0.02f / Exposure;
+            } else if (y >= 28) {
+                kind = Dark;
+                level = 0.001f;
+            }
+            kinds[p] = kind;
+            for (int c = 0; c < 3; ++c) {
+                scene_rgb[p * 3 + c] = level * tint[c];
+                scene_half[p * 4 + c] = ToHalf(level * tint[c]);
+                const float sdr = kind == Bloom  ? 0.8f
+                                  : kind == Glow ? 0.3f
+                                                 : Curve(Exposure * level * tint[c]);
+                before_ui[p * 4 + c] = Encode(sdr);
+            }
+            scene_half[p * 4 + 3] = ToHalf(1.0f);
+            before_ui[p * 4 + 3] = 255;
+        }
+    }
+    // Texels the game's effects can leave: NaN (must not spread) and inf (very bright).
+    std::vector<uint16_t> poisoned = scene_half;
+    const uint32_t nan_pixel = 2 * W + 2, inf_pixel = 2 * W + 6;
+    poisoned[nan_pixel * 4] = ToHalf(std::numeric_limits<float>::quiet_NaN());
+    poisoned[inf_pixel * 4 + 1] = ToHalf(std::numeric_limits<float>::infinity());
+    Upload(vk, staging, scene, poisoned.data());
+
+    // LUMA: the brightest channel, 2x2 max (r) and that of the 2x2 average (g), half size.
+    const auto reduce = [&] {
+        Bind(vk, luma, {{&scene}, {&luma_image}});
+        Begin(vk);
+        Dispatch(vk.cmd, luma, nullptr, 0, (LW + 7) / 8, (LH + 7) / 8);
+        Submit(vk);
+    };
+    reduce();
+    const auto luma_out = Download<uint16_t>(vk, staging, luma_image);
+    for (uint32_t y = 0; y < LH; ++y) {
+        for (uint32_t x = 0; x < LW; ++x) {
+            float peak = 0.0f;
+            std::array<float, 3> sum{};
+            for (uint32_t dy = 0; dy < 2; ++dy) {
+                for (uint32_t dx = 0; dx < 2; ++dx) {
+                    const uint32_t p = (y * 2 + dy) * W + x * 2 + dx;
+                    for (int c = 0; c < 3; ++c) {
+                        float v = FromHalf(poisoned[p * 4 + c]);
+                        v = std::isnan(v) ? 0.0f : std::min(v, 65504.0f);
+                        peak = std::max(peak, v);
+                        sum[c] += v;
+                    }
+                }
+            }
+            const float average = std::max({sum[0], sum[1], sum[2]}) * 0.25f;
+            const float r = FromHalf(luma_out[(y * LW + x) * 2]);
+            const float g = FromHalf(luma_out[(y * LW + x) * 2 + 1]);
+            assert(std::isfinite(r) && std::isfinite(g));
+            assert(std::abs(r - peak) <= peak * 2e-3f + 1e-6f);
+            assert(std::abs(g - average) <= average * 2e-3f + 1e-6f);
+        }
+    }
+    assert(FromHalf(luma_out[(1 * LW + 3) * 2]) == 65504.0f); // the inf texel's block
+    std::printf("HDR native shaders: luma (2x2 max and average, NaN, inf) PASS\n");
+    // The rest on the scene without them (an inf block would be an outlier of its own).
+    Upload(vk, staging, scene, scene_half.data());
+    reduce();
+
+    // SNAPSHOT + EXPOSURE at the first UI pass: the copy is exact, the exposure the game's.
+    const auto measure = [&](const Image& frame, bool copy_frame, uint32_t reset) {
+        const Pass& pass = copy_frame ? snapshot : stats;
+        std::vector<Resource> resources{{&frame}, {&luma_image}, {nullptr, &partials},
+                                        {nullptr, &state}};
+        if (copy_frame) {
+            resources.push_back({&copy});
+        }
+        Bind(vk, pass, resources);
+        Bind(vk, exposure, {{nullptr, &partials}, {nullptr, &state}});
+        const struct {
+            uint32_t count, reset;
+            float min_samples, rate;
+        } params{groups_x * groups_y, reset, 64.0f, 0.1f};
+        Begin(vk);
+        Dispatch(vk.cmd, pass, &reset, 4, groups_x, groups_y);
+        Dispatch(vk.cmd, exposure, &params, sizeof(params), 1, 1);
+        Submit(vk);
+        ExposureState result;
+        std::memcpy(&result, state.mapped, sizeof(result));
+        return result;
+    };
+    // Without bloom first (the scene's own SDR values there).
+    std::vector<uint8_t> no_bloom = before_ui;
+    for (uint32_t p = 0; p < W * H; ++p) {
+        if (kinds[p] == Bloom || kinds[p] == Glow) {
+            for (int c = 0; c < 3; ++c) {
+                no_bloom[p * 4 + c] = Encode(Curve(Exposure * scene_rgb[p * 3 + c]));
+            }
+        }
+    }
+    Upload(vk, staging, target, no_bloom.data());
+    ExposureState measured = measure(target, true, 1);
+    std::printf("HDR native shaders: exposure %.4f stops (expected %.4f), %.0f samples\n",
+                measured.log_scale, std::log2(Exposure), measured.samples);
+    assert(measured.valid == 1.0f && measured.samples > 500.0f);
+    assert(std::abs(measured.log_scale - std::log2(Exposure)) < 0.03f);
+    const auto copied = Download<uint8_t>(vk, staging, copy);
+    assert(copied == no_bloom); // bit for bit
+    std::printf("HDR native shaders: snapshot copy and exposure PASS\n");
+
+    // Bloom: SDR midtones lit up around the light where the scene is dark (the glow ring, ~4
+    // stops above the exposure). The first frame (no previous exposure) is pulled up; frames
+    // after weigh the outliers down.
+    std::memset(state.mapped, 0, sizeof(ExposureState));
+    Upload(vk, staging, target, before_ui.data());
+    measured = measure(target, false, 1);
+    const float first_error = std::abs(measured.log_scale - std::log2(Exposure));
+    for (int frame = 0; frame < 60; ++frame) {
+        measured = measure(target, false, 0);
+    }
+    const float settled_error = std::abs(measured.log_scale - std::log2(Exposure));
+    std::printf("HDR native shaders: with bloom %.3f stops off at first, %.3f after 60 frames\n",
+                first_error, settled_error);
+    assert(first_error > 0.1f && settled_error < 0.5f * first_error && settled_error < 0.15f);
+    // A frame with nothing to measure keeps the exposure; after a reset it has none.
+    std::vector<uint8_t> black(W * H * 4, 0);
+    Upload(vk, staging, target, black.data());
+    const ExposureState kept = measure(target, false, 0);
+    assert(kept.valid == 1.0f && kept.log_scale == measured.log_scale && kept.samples == 0.0f);
+    const ExposureState dropped = measure(target, false, 1);
+    assert(dropped.valid == 0.0f);
+    std::printf("HDR native shaders: bloom-resistant exposure, empty frames PASS\n");
+
+    // GAIN at the display pass: the frame as the first UI pass saw it, then UI drawn over it.
+    Upload(vk, staging, target, no_bloom.data());
+    measured = measure(target, true, 1);
+    std::vector<uint8_t> finished = no_bloom;
+    const auto ui = [](uint32_t x, uint32_t y) { return x >= 42 && x < 60 && y >= 22 && y < 26; };
+    for (uint32_t y = 0; y < H; ++y) {
+        for (uint32_t x = 0; x < W; ++x) {
+            if (ui(x, y)) {
+                const uint32_t p = y * W + x;
+                finished[p * 4] = 250;
+                finished[p * 4 + 1] = 250;
+                finished[p * 4 + 2] = uint8_t(finished[p * 4 + 2] ^ 0x5a);
+            }
+        }
+    }
+    // Also UI over the light: HUD over a lamp stays at paper white.
+    for (uint32_t x = 40; x < 44; ++x) {
+        finished[(12 * W + x) * 4] ^= 0x08;
+    }
+    Upload(vk, staging, target, finished.data());
+    const float white = 1000.0f / 200.0f; // the default peak / paper white
+    for (const float strength : {1.0f, 0.5f}) {
+        const struct {
+            float strength, white, knee, unused;
+        } params{strength, white, Knee, 0.0f};
+        Bind(vk, gain, {{&target}, {&copy}, {&luma_image}, {nullptr, &state}, {&gain_map}});
+        Begin(vk);
+        Dispatch(vk.cmd, gain, &params, sizeof(params), (W + 7) / 8, (H + 7) / 8);
+        Submit(vk);
+        const auto map = Download<uint16_t>(vk, staging, gain_map);
+        const float scale = std::exp2(measured.log_scale);
+        float light_gain = 0.0f;
+        for (uint32_t y = 0; y < H; ++y) {
+            for (uint32_t x = 0; x < W; ++x) {
+                const uint32_t p = y * W + x;
+                const float g = FromHalf(map[p]);
+                const bool on_ui = ui(x, y) || (y == 12 && x >= 40 && x < 44);
+                float sdr = 0.0f;
+                for (int c = 0; c < 3; ++c) {
+                    sdr = std::max(sdr, std::pow(no_bloom[p * 4 + c] / 255.0f, 2.2f));
+                }
+                if (on_ui) {
+                    assert(g == -1.0f); // UI: gain 1, marked for the debug view
+                } else if (sdr <= Knee) {
+                    assert(g == 1.0f); // midtones: the SDR picture exactly
+                } else {
+                    assert(g >= 1.0f && sdr * g <= white * 1.001f);
+                }
+                if (kinds[p] == Light && !on_ui && x > 41 && x < 46 && y > 9 && y < 14) {
+                    // Inside the light (its 4x4 footprint in the luma is all light): the
+                    // scene's ratio to the SDR white, to the power of the strength, into the
+                    // peak (unchanged up to halfway, then towards the peak).
+                    const float ratio = scale * 8.0f / Exposure / sdr;
+                    float target_value = sdr * std::pow(ratio, strength);
+                    const float start = 0.5f * (1.0f + white);
+                    if (target_value > start) {
+                        target_value = start + (white - start) *
+                                                   (1.0f - std::exp(-(target_value - start) /
+                                                                    (white - start)));
+                    }
+                    const float expected = target_value / sdr;
+                    if (std::abs(g - expected) > expected * 0.01f) {
+                        std::fprintf(stderr, "gain %.4f, expected %.4f at %u,%u\n", g, expected,
+                                     x, y);
+                    }
+                    assert(std::abs(g - expected) <= expected * 0.01f);
+                    light_gain = g;
+                }
+            }
+        }
+        std::printf("HDR native shaders: gain map (strength %.2f: light x%.3f) PASS\n", strength,
+                    light_gain);
+    }
+    // No scene brighter than the SDR frame (bloom ring): no gain.
+    {
+        Upload(vk, staging, target, before_ui.data());
+        measured = measure(target, true, 1);
+        const struct {
+            float strength, white, knee, unused;
+        } params{1.0f, white, Knee, 0.0f};
+        Bind(vk, gain, {{&target}, {&copy}, {&luma_image}, {nullptr, &state}, {&gain_map}});
+        Begin(vk);
+        Dispatch(vk.cmd, gain, &params, sizeof(params), (W + 7) / 8, (H + 7) / 8);
+        Submit(vk);
+        const auto map = Download<uint16_t>(vk, staging, gain_map);
+        uint32_t checked = 0;
+        for (uint32_t y = 0; y < H; ++y) {
+            for (uint32_t x = 0; x < W; ++x) {
+                // Bright bloom (above the knee) outside the light's luma footprint (the 2x2
+                // luma texels around reach 2 scene pixels further).
+                if (kinds[y * W + x] == Bloom && (x <= 38 || x >= 49 || y <= 6 || y >= 17)) {
+                    assert(FromHalf(map[y * W + x]) == 1.0f);
+                    ++checked;
+                }
+            }
+        }
+        assert(checked >= 40);
+        std::printf("HDR native shaders: bloom (SDR brighter than the scene) keeps gain 1 PASS\n");
+    }
+    vkDeviceWaitIdle(vk.device);
+    std::printf("HDR native shaders: PASS\n");
+    return 0;
+}
diff --git a/tests/test_occlusion.cpp b/tests/test_occlusion.cpp
new file mode 100644
index 0000000..89dd2e5
--- /dev/null
+++ b/tests/test_occlusion.cpp
@@ -0,0 +1,136 @@
+// The depth-block counter model behind real occlusion results (occlusion_model.h).
+#include <cassert>
+#include <cstdint>
+#include <cstdio>
+
+#include "gpu/shadps4/video_core/renderer_vulkan/occlusion_model.h"
+
+using namespace OcclusionModel;
+
+namespace {
+// The words two dumps write into a block: the begin dump at +0, the end dump at +8.
+void Dump(std::uint64_t* block, std::uint32_t pipes, std::uint64_t total, bool end) {
+    for (std::uint32_t k = 0; k < pipes; ++k) {
+        block[2 * k + (end ? 1 : 0)] = Share(total, pipes, k) | ValidBit;
+    }
+}
+
+std::uint64_t SumOfDifferences(const std::uint64_t* block, std::uint32_t pipes) {
+    std::uint64_t sum = 0;
+    for (std::uint32_t k = 0; k < pipes; ++k) {
+        sum += (block[2 * k + 1] & ~ValidBit) - (block[2 * k] & ~ValidBit);
+    }
+    return sum;
+}
+} // namespace
+
+int main() {
+    // The shares add up to the total, and every DB's share grows with it: the game's sum of
+    // end - begin is the samples drawn in between, whatever the split.
+    for (std::uint32_t pipes : {8u, 16u}) {
+        for (std::uint64_t total = 0; total < 200; ++total) {
+            std::uint64_t sum = 0;
+            for (std::uint32_t k = 0; k < pipes; ++k) {
+                sum += Share(total, pipes, k);
+                assert(Share(total + 1, pipes, k) >= Share(total, pipes, k));
+            }
+            assert(sum == total);
+        }
+        for (std::uint64_t begin : {0ull, 7ull, 123456789ull}) {
+            for (std::uint64_t samples : {0ull, 1ull, 5ull, 4000ull}) {
+                std::uint64_t block[2 * MaxPipes] = {};
+                assert(ReadBlock(block, pipes) == Block::NotReady); // zeroed by the game
+                Dump(block, pipes, begin, false);
+                assert(ReadBlock(block, pipes) == Block::NotReady); // only the begin landed
+                Dump(block, pipes, begin + samples, true);
+                assert(SumOfDifferences(block, pipes) == samples);
+                assert(ReadBlock(block, pipes) == (samples ? Block::Visible : Block::Occluded));
+            }
+        }
+    }
+
+    // Anything not measured reads visible, never occluded.
+    assert(Samples(0, false, true, 1u << 16) == Unmeasured);
+    assert(Samples(0, false, false, 1u << 16) == Unmeasured);
+    assert(Samples(1, true, false, 1u << 16) == Unmeasured); // imprecise 0/1: plainly visible
+    assert(Samples(0, true, false, 1u << 16) == 0);
+    assert(Samples(0, true, true, 4u << 16) == 0);           // occluded stays occluded
+    assert(Samples(10, true, true, 1u << 16) == 10);
+    assert(Samples(1, true, true, (1u << 16) + 1) == 2);      // rounds up, never down
+
+    // Reduced scene targets count fewer samples: scaled back to 1920x1080, never below 1.
+    assert(SampleScale(1920, 1080) == 1u << 16);
+    assert(SampleScale(3840, 2160) == 1u << 16);
+    assert(SampleScale(960, 540) == 4u << 16);
+    assert(SampleScale(0, 0) == 1u << 16);
+    assert(Samples(250, true, true, SampleScale(960, 540)) == 1000);
+
+    // SET_PREDICATION: unknown draws; otherwise draws when visibility matches the request.
+    assert(PredicatedDraws(false, true, true));
+    assert(PredicatedDraws(false, true, false));
+    assert(PredicatedDraws(true, false, true));
+    assert(!PredicatedDraws(false, false, true));
+    assert(PredicatedDraws(false, false, false));
+    assert(!PredicatedDraws(true, false, false));
+
+    // Hysteresis: the largest of the last three results; occluded only after three results in
+    // a row found nothing, visible at once; an unseen past reads visible with the least count.
+    {
+        BlockHistory fresh;
+        assert(fresh.Report(0) == BlockHistory::UnknownPast);
+        assert(fresh.Report(0) == BlockHistory::UnknownPast);
+        assert(fresh.Report(0) == 0);
+        assert(fresh.Report(0) == 0);
+        assert(fresh.Report(9) == 9); // visible at once
+        assert(fresh.Report(0) == 9);
+        assert(fresh.Report(0) == 9);
+        assert(fresh.Report(0) == 0);
+    }
+    {
+        // A lamp flickering 0/N/0 under jitter reads steadily visible.
+        BlockHistory lamp;
+        const std::uint64_t measured[] = {40, 0, 35, 0, 0, 41, 0, 38};
+        for (const std::uint64_t m : measured) {
+            assert(lamp.Report(m) >= 35);
+        }
+        // The largest of the last three: a drop shows after two more results.
+        BlockHistory fading;
+        fading.Report(100);
+        fading.Report(100);
+        fading.Report(100);
+        assert(fading.Report(10) == 100);
+        assert(fading.Report(10) == 100);
+        assert(fading.Report(10) == 10);
+        // Unmeasured (fail-safe visible) counts too.
+        BlockHistory unknown;
+        unknown.Report(0);
+        unknown.Report(0);
+        assert(unknown.Report(Unmeasured) == Unmeasured);
+        assert(unknown.Report(0) == Unmeasured);
+    }
+    {
+        // As the resolver writes it: the held count is added to the running total between the
+        // begin and the end dump, so the game reads the held result from the block.
+        for (std::uint32_t pipes : {8u, 16u}) {
+            BlockHistory history;
+            std::uint64_t total = 1000;
+            const std::uint64_t measured[] = {12, 0, 0, 0, 5};
+            const Block expected[] = {Block::Visible, Block::Visible, Block::Visible,
+                                      Block::Occluded, Block::Visible};
+            for (std::size_t i = 0; i < sizeof(measured) / sizeof(measured[0]); ++i) {
+                std::uint64_t block[2 * MaxPipes] = {};
+                Dump(block, pipes, total, false);
+                const std::uint64_t begin = total;
+                total += measured[i];
+                const std::uint64_t reported = history.Report(total - begin);
+                total += reported - (total - begin);
+                Dump(block, pipes, total, true);
+                assert(SumOfDifferences(block, pipes) == reported);
+                assert(ReadBlock(block, pipes) == expected[i]);
+            }
+        }
+    }
+
+    std::printf("occlusion model: ok\n");
+    return 0;
+}
diff --git a/tests/test_pipeline_compile.cpp b/tests/test_pipeline_compile.cpp
new file mode 100644
index 0000000..b14cae2
--- /dev/null
+++ b/tests/test_pipeline_compile.cpp
@@ -0,0 +1,231 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// Pipeline compiles off the frame path (docs/pipeline_compiles.md): the compile job queue a
+// waiting thread takes its job from, the bound on leaving draws out, the texture cache's
+// lock-free page watch counts, and the draw pipe's sleeping waits (no Vulkan device).
+#include <atomic>
+#include <cassert>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <memory>
+#include <thread>
+#include <vector>
+
+#include "bbport_platform.h"
+#include "video_core/renderer_vulkan/pipeline_compile_queue.h"
+#include "video_core/renderer_vulkan/vk_draw_pipe.h"
+#include "video_core/texture_cache/watched_pages.h"
+
+using namespace std::chrono_literals;
+
+namespace {
+
+void TestJobQueue() {
+    Vulkan::PipelineJobQueue queue;
+    int a = 0, b = 0, c = 0;
+    std::vector<char> order;
+    queue.Push(&a, [&] { order.push_back('a'); });
+    queue.Push(&b, [&] { order.push_back('b'); });
+    queue.Push(&c, [&] { order.push_back('c'); });
+    assert(queue.Size() == 3);
+    // A thread that needs b takes it out of the queue and runs it itself.
+    auto job = queue.Take(&b);
+    assert(job);
+    job();
+    assert(!queue.Take(&b)); // gone: a second waiter waits for the first one's result
+    assert(queue.Size() == 2);
+    // The compile threads go on first in, first out with the rest.
+    queue.Pop()();
+    queue.Pop()();
+    assert((order == std::vector<char>{'b', 'a', 'c'}));
+    assert(!queue.Take(&a) && queue.Size() == 0);
+
+    // A compile thread and takers at once: every job runs exactly once.
+    constexpr int Jobs = 2000;
+    std::vector<int> owners(Jobs);
+    std::vector<std::atomic<int>> runs(Jobs);
+    for (int i = 0; i < Jobs; ++i) {
+        queue.Push(&owners[i], [&, i] {
+            runs[i].fetch_add(1);
+            std::this_thread::yield();
+        });
+    }
+    std::atomic<bool> stop{false};
+    std::thread worker([&] {
+        while (!stop.load()) {
+            queue.Pop()();
+        }
+    });
+    for (int i = Jobs - 1; i >= 0; i -= 3) {
+        if (auto j = queue.Take(&owners[i])) {
+            j();
+        }
+    }
+    // Last in the queue: the compile thread has run every job left before it.
+    queue.Push(nullptr, [&] { stop.store(true); });
+    worker.join();
+    assert(queue.Size() == 0);
+    for (int i = 0; i < Jobs; ++i) {
+        assert(runs[i].load() == 1);
+    }
+}
+
+void TestSkipBudget() {
+    using Vulkan::WithinSkipBudget;
+    constexpr std::uint64_t Ms = 1'000'000;
+    std::uint64_t first = 0;
+    assert(WithinSkipBudget(first, 5 * Ms, 1000 * Ms) && first == 5 * Ms);
+    assert(WithinSkipBudget(first, 500 * Ms, 1000 * Ms) && first == 5 * Ms);
+    assert(WithinSkipBudget(first, 1004 * Ms, 1000 * Ms));
+    assert(!WithinSkipBudget(first, 1005 * Ms, 1000 * Ms)); // waits from then on
+    assert(!WithinSkipBudget(first, 9000 * Ms, 1000 * Ms));
+    std::uint64_t never = 0;
+    assert(!WithinSkipBudget(never, 7 * Ms, 0)); // BB_SKIP_UNCOMPILED=0
+    std::uint64_t at_zero = 0;
+    assert(WithinSkipBudget(at_zero, 0, 10) && at_zero != 0);
+}
+
+void TestWatchedPages() {
+    auto pages = std::make_unique<VideoCore::WatchedPages>();
+    constexpr std::uint64_t P = 4096;
+    const std::uint64_t base = 0x2'4000'0000ull; // another chunk than below
+    assert(!pages->Any(base, 8));
+    // An image over three pages, not page aligned (TrackImage: the whole image).
+    const std::uint64_t begin = base + 0x800, end = base + 2 * P + 0x100;
+    pages->Add(begin, end - begin, 1);
+    assert(pages->Any(base, 8) && pages->Any(base + P, 8) && pages->Any(base + 2 * P + 0xff0, 8));
+    assert(!pages->Any(base + 3 * P, 8) && !pages->Any(base - 8, 8));
+    // UntrackImageHead: [begin, next page), then UntrackImageTail: [page of end, end): the
+    // counts follow the page manager's (each sub-range's own pages).
+    pages->Add(begin, base + P - begin, -1);
+    assert(!pages->Any(base + 0x900, 8) && pages->Any(base + P, 8));
+    pages->Add(base + 2 * P, end - (base + 2 * P), -1);
+    assert(!pages->Any(base + 2 * P + 8, 8) && pages->Any(base + P + 8, 8));
+    // A second image sharing the middle page keeps it watched after the first one goes.
+    pages->Add(base + P + 0x200, 0x100, 1);
+    pages->Add(base + P, P, -1); // UntrackImage of what is left of the first
+    assert(pages->Any(base + P, 8));
+    pages->Add(base + P + 0x200, 0x100, -1);
+    assert(!pages->Any(base, 3 * P));
+    // A range across pages, and a page-aligned tail of size 0 (no page), as the page manager.
+    pages->Add(base + 5 * P, 0, -1);
+    assert(!pages->Any(base + 5 * P, 1));
+    // Addresses past the table count as watched (the locked path).
+    assert(pages->Any(std::uint64_t{1} << 41, 8));
+    // Untracking more than tracked stays at zero instead of wrapping.
+    pages->Add(base + 9 * P, P, -1);
+    assert(!pages->Any(base + 9 * P, 8));
+}
+
+// The draw pipe's stage A waits: packets that run long (a pipeline compile, an image created
+// with memory short) must not keep stage A spinning, and a wake-up must never be lost.
+std::atomic<int> long_packets{0};
+std::atomic<std::uint64_t> handled{0};
+void Handler(void*, const u8* packet, u32 size) {
+    u32 sleep_ms = 0;
+    std::memcpy(&sleep_ms, packet, sizeof(sleep_ms));
+    if (sleep_ms) {
+        long_packets.fetch_add(1);
+        std::this_thread::sleep_for(std::chrono::milliseconds(sleep_ms));
+    }
+    assert(size == sizeof(u32));
+    handled.fetch_add(1, std::memory_order_relaxed);
+}
+
+void Post(Vulkan::DrawPipe& pipe, u32 sleep_ms) {
+    u8* out = pipe.Begin(sizeof(u32));
+    std::memcpy(out, &sleep_ms, sizeof(sleep_ms));
+    pipe.Commit(sizeof(u32));
+}
+
+std::uint64_t ThreadCpuUs() {
+    BbPlatform::Usage usage;
+    return BbPlatform::GetUsage(true, usage) ? usage.user_us + usage.sys_us : 0;
+}
+
+void TestDrawPipeWaits() {
+    Vulkan::DrawPipe pipe(&Handler, nullptr);
+    // A drain behind a 300 ms packet: stage A sleeps (stage B wakes it), using little CPU.
+    Post(pipe, 0);
+    Post(pipe, 300);
+    const std::uint64_t cpu_before = ThreadCpuUs();
+    const auto start = std::chrono::steady_clock::now();
+    pipe.Drain();
+    const auto waited = std::chrono::steady_clock::now() - start;
+    const std::uint64_t cpu_us = ThreadCpuUs() - cpu_before;
+    assert(pipe.Idle() && handled.load() == 2);
+    assert(waited >= 250ms);
+    std::printf("drain behind a 300 ms packet: waited %lld ms, %llu us on the CPU, %llu sleeps\n",
+                static_cast<long long>(
+                    std::chrono::duration_cast<std::chrono::milliseconds>(waited).count()),
+                static_cast<unsigned long long>(cpu_us),
+                static_cast<unsigned long long>(pipe.sleeps));
+    if (Vulkan::DrawPipe::SleepEnabled()) {
+        assert(pipe.sleeps >= 1);
+        // Spin (4096 pauses) and yield for 0.5 ms, then asleep: far below the 300 ms.
+        assert(cpu_us < 60'000);
+    }
+
+    // WaitForPacket for one in the middle of long ones.
+    const u64 number = pipe.NextPacket() + 1;
+    Post(pipe, 20);
+    Post(pipe, 20);
+    Post(pipe, 200);
+    pipe.WaitForPacket(number, Vulkan::DrawPipe::ReasonConstRam);
+    assert(pipe.ReachedPacket(number));
+    pipe.Drain();
+
+    // Many short packets with drains and packet waits in between, a watchdog for a lost
+    // wake-up (stage A asleep with nothing left for stage B to run: a hang).
+    std::atomic<bool> finished{false};
+    std::thread watchdog([&] {
+        std::uint64_t last = handled.load();
+        for (int quiet = 0; !finished.load(); std::this_thread::sleep_for(100ms)) {
+            const std::uint64_t now = handled.load();
+            quiet = now == last ? quiet + 1 : 0;
+            last = now;
+            if (quiet > 100) {
+                std::fprintf(stderr, "draw pipe wait hung (lost wake-up)\n");
+                std::abort();
+            }
+        }
+    });
+    std::uint64_t rng = 0x9e3779b97f4a7c15ull;
+    for (int i = 0; i < 20000; ++i) {
+        rng ^= rng << 13;
+        rng ^= rng >> 7;
+        rng ^= rng << 17;
+        Post(pipe, (rng & 1023) == 0 ? 2 : 0);
+        switch (rng >> 61) {
+        case 0:
+            pipe.Drain();
+            assert(pipe.Idle());
+            break;
+        case 1:
+            pipe.WaitForPacket(pipe.NextPacket() - 1, Vulkan::DrawPipe::ReasonRasterizer);
+            break;
+        default:
+            break;
+        }
+    }
+    pipe.Drain();
+    finished.store(true);
+    watchdog.join();
+    assert(pipe.Idle() && handled.load() == pipe.packets);
+    std::printf("%llu packets, %llu drains that waited, %llu slept, %d long packets\n",
+                static_cast<unsigned long long>(pipe.packets),
+                static_cast<unsigned long long>(pipe.drains),
+                static_cast<unsigned long long>(pipe.sleeps), long_packets.load());
+}
+
+} // namespace
+
+int main() {
+    TestJobQueue();
+    TestSkipBudget();
+    TestWatchedPages();
+    TestDrawPipeWaits();
+    std::printf("pipeline compile tests passed\n");
+    return 0;
+}
