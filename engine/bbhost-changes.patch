+        .boost = std::clamp(settings.hdr_boost.load(), 0.0f, 1.0f),
+        .flags = (scrgb ? HostPasses::HdrOutputPass::FlagScRgb : 0u) |
+                 (overlay ? HostPasses::HdrOutputPass::FlagOverlay : 0u),
+    };
