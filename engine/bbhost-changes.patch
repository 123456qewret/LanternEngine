+    }
+    ++sampler_memo_misses;
+    size_t lru_id = 0;
+    const vk::Sampler handle =
+        texture_cache.GetSampler(sharp, Regs().ta_bc_base, is_depth, lod_bias, &lru_id);
+    entry = {words, variant, handle, lru_id, generation, tick};
+    return handle;
+}
