+    EXCEPTION_RECORD *r = e->ExceptionRecord;
+    if (r->ExceptionCode == EXCEPTION_BREAKPOINT) return;
+    if (!runtime_thread_has_record() && InterlockedIncrement(&notes) > 4) return;
