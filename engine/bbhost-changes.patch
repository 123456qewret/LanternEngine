diff --git a/gpu/shim/bbport_sampler.cpp b/gpu/shim/bbport_sampler.cpp
new file mode 100644
index 0000000..ca56857
--- /dev/null
+++ b/gpu/shim/bbport_sampler.cpp
@@ -0,0 +1,238 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// bbport: BB_SAMPLE_THREADS=<names> - where those threads run, for loading-time work (Windows; the
+// Linux runtime has BB_SAMPLE_THREAD in runtime_kernel.c). Names are comma-separated prefixes of
+// thread descriptions (guest threads carry theirs), "main" is the process's first thread (the
+// game's main loop), and "load" is main, GXRenderThread and the game's Core.Res.* file loaders.
+// About every 2 ms each is suspended, its instruction pointer read and resumed; samples in host
+// code are kept with the first return address into the game on the stack. Every 5 s, per thread:
+// the share in game code, in each host module (waiting shows as ntdll/KernelBase), and the
+// hottest sites.
+#include "bbport_sampler.h"
+
+#ifdef _WIN32
+#include <windows.h>
+#include <tlhelp32.h>
+#include <algorithm>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <map>
+#include <string>
+#include <thread>
+#include <utility>
+#include <vector>
+#include "bbport_platform.h"
+
+#ifndef CREATE_WAITABLE_TIMER_HIGH_RESOLUTION
+#define CREATE_WAITABLE_TIMER_HIGH_RESOLUTION 0x00000002
+#endif
+
+namespace BbSampler {
+namespace {
+constexpr unsigned long long kGuestLo = 0x800000000ull, kGuestHi = 0x810000000ull;
+
+/// A sample: the instruction (guest offset when in game code) and, in host code, the first guest
+/// return address on the stack (offset; 0 when none).
+using Site = std::pair<unsigned long long, unsigned long long>;
+
+struct Target {
+    HANDLE handle = nullptr;
+    std::string name;
+    unsigned long long samples = 0;
+    std::map<Site, unsigned long long> sites;
+};
+
+std::vector<std::string> Wanted() {
+    std::vector<std::string> names;
+    const char* env = std::getenv("BB_SAMPLE_THREADS");
+    std::string list = env ? env : "";
+    if (list == "load") list = "main,GXRenderThread,Core.Res.";
+    size_t start = 0;
+    for (;;) {
+        const size_t comma = list.find(',', start);
+        std::string name = list.substr(start, comma == std::string::npos ? std::string::npos : comma - start);
+        if (!name.empty()) names.push_back(name);
+        if (comma == std::string::npos) break;
+        start = comma + 1;
+    }
+    return names;
+}
+
+std::string Describe(HANDLE thread) {
+    PWSTR wide = nullptr;
+    std::string name;
+    if (SUCCEEDED(GetThreadDescription(thread, &wide)) && wide) {
+        char text[128] = {};
+        WideCharToMultiByte(CP_UTF8, 0, wide, -1, text, sizeof(text) - 1, nullptr, nullptr);
+        name = text;
+        LocalFree(wide);
+    }
+    return name;
+}
+
+constexpr DWORD kAccess = THREAD_SUSPEND_RESUME | THREAD_GET_CONTEXT | THREAD_QUERY_LIMITED_INFORMATION;
+
+// The process's threads whose description starts with one of `wanted` ("main": the first one).
+void Refresh(const std::vector<std::string>& wanted, std::map<DWORD, Target>& targets) {
+    HANDLE snapshot = CreateToolhelp32Snapshot(TH32CS_SNAPTHREAD, 0);
+    if (snapshot == INVALID_HANDLE_VALUE) return;
+    const DWORD pid = GetCurrentProcessId(), self = GetCurrentThreadId();
+    const bool want_main = std::find(wanted.begin(), wanted.end(), "main") != wanted.end();
+    THREADENTRY32 entry{};
+    entry.dwSize = sizeof(entry);
+    DWORD first = 0;
+    FILETIME first_created{0xffffffffu, 0xffffffffu};
+    std::vector<DWORD> seen;
+    for (BOOL ok = Thread32First(snapshot, &entry); ok; ok = Thread32Next(snapshot, &entry)) {
+        if (entry.th32OwnerProcessID != pid || entry.th32ThreadID == self) continue;
+        seen.push_back(entry.th32ThreadID);
+        HANDLE thread = OpenThread(kAccess, FALSE, entry.th32ThreadID);
+        if (!thread) continue;
+        FILETIME created{}, unused{};
+        if (want_main && GetThreadTimes(thread, &created, &unused, &unused, &unused) &&
+            CompareFileTime(&created, &first_created) < 0) {
+            first_created = created;
+            first = entry.th32ThreadID;
+        }
+        bool want = false;
+        if (!targets.count(entry.th32ThreadID)) {
+            const std::string name = Describe(thread);
+            for (const auto& w : wanted) want |= w != "main" && !name.empty() && name.rfind(w, 0) == 0;
+            if (want) targets[entry.th32ThreadID] = Target{thread, name};
+        }
+        if (!want) CloseHandle(thread);
+    }
+    CloseHandle(snapshot);
+    if (first && !targets.count(first)) {
+        if (HANDLE thread = OpenThread(kAccess, FALSE, first)) targets[first] = Target{thread, "main"};
+    }
+    for (auto it = targets.begin(); it != targets.end();) { // threads that ended
+        if (std::find(seen.begin(), seen.end(), it->first) == seen.end()) {
+            CloseHandle(it->second.handle);
+            it = targets.erase(it);
+        } else {
+            ++it;
+        }
+    }
+}
+
+bool Sample(Target& t, Site* site) {
+    if (SuspendThread(t.handle) == static_cast<DWORD>(-1)) return false;
+    CONTEXT context{};
+    context.ContextFlags = CONTEXT_CONTROL;
+    unsigned long long rip = 0, caller = 0;
+    if (GetThreadContext(t.handle, &context)) {
+        rip = context.Rip;
+        if (rip < kGuestLo || rip >= kGuestHi) {
+            // Read while the thread is suspended: its stack can't change under us.
+            unsigned long long stack[192] = {};
+            if (BbPlatform::ReadProcessMemory(reinterpret_cast<const void*>(context.Rsp), stack, sizeof(stack))) {
+                for (const auto value : stack) {
+                    if (value >= kGuestLo && value < kGuestHi) {
+                        caller = value - kGuestLo;
+                        break;
+                    }
+                }
+            }
+        }
+    }
+    ResumeThread(t.handle);
+    if (!rip) return false;
+    *site = rip >= kGuestLo && rip < kGuestHi ? Site{rip - kGuestLo, ~0ull} : Site{rip, caller};
+    return true;
+}
+
+std::string Module(unsigned long long address, bool with_offset) {
+    char text[512];
+    BbPlatform::DescribeAddress(reinterpret_cast<const void*>(address), text, sizeof(text));
+    std::string s = text;
+    const size_t slash = s.find_last_of("\\/");
+    if (slash != std::string::npos) s = s.substr(slash + 1);
+    if (!with_offset) {
+        const size_t plus = s.find('+');
+        if (plus != std::string::npos) s = s.substr(0, plus);
+    }
+    return s;
+}
+
+void Report(std::map<DWORD, Target>& targets) {
+    for (auto& [id, t] : targets) {
+        if (!t.samples) continue;
+        std::map<std::string, unsigned long long> modules;
+        unsigned long long guest = 0;
+        for (const auto& [site, count] : t.sites) {
+            if (site.second == ~0ull) guest += count;
+            else modules[Module(site.first, false)] += count;
+        }
+        std::vector<std::pair<Site, unsigned long long>> hot(t.sites.begin(), t.sites.end());
+        std::sort(hot.begin(), hot.end(), [](const auto& a, const auto& b) { return a.second > b.second; });
+        std::vector<std::pair<std::string, unsigned long long>> mods(modules.begin(), modules.end());
+        std::sort(mods.begin(), mods.end(), [](const auto& a, const auto& b) { return a.second > b.second; });
+        std::printf("Samples %s (%llu): game code %.0f%%", t.name.c_str(), t.samples, 100.0 * guest / t.samples);
+        for (size_t i = 0; i < mods.size() && i < 5; ++i)
+            std::printf(", %s %.0f%%", mods[i].first.c_str(), 100.0 * mods[i].second / t.samples);
+        std::printf("; hottest:");
+        for (size_t i = 0; i < hot.size() && i < 8; ++i) {
+            const auto& [site, count] = hot[i];
+            if (site.second == ~0ull)
+                std::printf(" +%#llx %.0f%%", site.first, 100.0 * count / t.samples);
+            else
+                std::printf(" %s (from +%#llx) %.0f%%", Module(site.first, true).c_str(), site.second,
+                            100.0 * count / t.samples);
+        }
+        std::printf("\n");
+        t.samples = 0;
+        t.sites.clear();
+    }
+    std::fflush(stdout);
+}
+
+void Run(std::vector<std::string> wanted) {
+    std::map<DWORD, Target> targets;
+    // A high-resolution timer: ~2 ms waits without changing the system timer resolution.
+    HANDLE timer = CreateWaitableTimerExW(nullptr, nullptr, CREATE_WAITABLE_TIMER_HIGH_RESOLUTION, TIMER_ALL_ACCESS);
+    auto last_refresh = std::chrono::steady_clock::now() - std::chrono::seconds(10);
+    auto last_report = std::chrono::steady_clock::now();
+    std::printf("Sampler: BB_SAMPLE_THREADS=%s, about every 2 ms, reported every 5 s\n", std::getenv("BB_SAMPLE_THREADS"));
+    for (;;) {
+        const auto now = std::chrono::steady_clock::now();
+        if (now - last_refresh >= std::chrono::seconds(2)) {
+            Refresh(wanted, targets);
+            last_refresh = now;
+        }
+        for (auto& [id, t] : targets) {
+            Site site;
+            if (Sample(t, &site)) {
+                ++t.samples;
+                ++t.sites[site];
+            }
+        }
+        if (now - last_report >= std::chrono::seconds(5)) {
+            Report(targets);
+            last_report = now;
+        }
+        if (timer) {
+            LARGE_INTEGER due;
+            due.QuadPart = -20000; // 2 ms, relative, in 100 ns units
+            if (SetWaitableTimer(timer, &due, 0, nullptr, nullptr, FALSE)) WaitForSingleObject(timer, INFINITE);
+        } else {
+            std::this_thread::sleep_for(std::chrono::milliseconds(2));
+        }
+    }
+}
+} // namespace
+
+void Start() {
+    static bool started = false;
+    if (started) return;
+    auto wanted = Wanted();
+    if (wanted.empty()) return;
+    started = true;
+    std::thread(Run, std::move(wanted)).detach();
+}
+} // namespace BbSampler
+#else
+namespace BbSampler {
+void Start() {}
+} // namespace BbSampler
+#endif
