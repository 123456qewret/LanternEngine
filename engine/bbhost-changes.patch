+} // namespace
+
+HdrNative::HdrNative(const Instance& instance_, Scheduler& scheduler_,
+                     VideoCore::TextureCache& texture_cache_, Runtime& runtime_)
+    : instance{instance_}, scheduler{scheduler_}, texture_cache{texture_cache_},
+      runtime{runtime_} {
+    CreatePipelines();
+    // The exposure state: four floats the EXPOSURE pass keeps across frames (cleared by the
+    // first pass that uses it).
+    const VkBufferCreateInfo buffer_ci{
+        .sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO,
+        .size = StateSize,
+        .usage = VK_BUFFER_USAGE_STORAGE_BUFFER_BIT | VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+    };
+    const VmaAllocationCreateInfo alloc_ci{.usage = VMA_MEMORY_USAGE_AUTO_PREFER_DEVICE};
+    VkBuffer buffer{};
+    const VkResult result = vmaCreateBuffer(instance.GetAllocator(), &buffer_ci, &alloc_ci,
+                                            &buffer, &state.allocation, nullptr);
+    ASSERT_MSG(result == VK_SUCCESS, "HDR native: exposure buffer allocation failed");
+    state.buffer = vk::Buffer{buffer};
+    state.size = StateSize;
+}
+
+HdrNative::~HdrNative() {
+    // The presenter finished the GPU's work before the rasterizer goes.
+    const auto device = instance.GetDevice();
+    for (const auto& entry : view_cache) {
+        if (entry.view) {
+            device.destroyImageView(entry.view);
+        }
+    }
+    for (Buffer* buffer : {&partials, &state}) {
+        if (buffer->buffer) {
+            vmaDestroyBuffer(instance.GetAllocator(), buffer->buffer, buffer->allocation);
+        }
+    }
+}
+
+bool HdrNative::Wanted() {
+    const auto& s = BbSettings::Get();
+    return s.hdr_output.load(std::memory_order_relaxed) != BbSettings::HdrOutputOff &&
+           s.hdr_mode.load(std::memory_order_relaxed) == BbSettings::HdrModeNative;
+}
+
+void HdrNative::CreatePipelines() {
+    const auto device = instance.GetDevice();
+    const auto make = [&](std::initializer_list<vk::DescriptorType> types, u32 push_size,
+                          std::span<const u32> code, const char* name,
+                          vk::UniqueDescriptorSetLayout& set_layout,
+                          vk::UniquePipelineLayout& pipeline_layout, vk::UniquePipeline& pipeline) {
+        std::array<vk::DescriptorSetLayoutBinding, 5> bindings{};
+        u32 count = 0;
+        for (const vk::DescriptorType type : types) {
+            bindings[count] = {.binding = count,
+                               .descriptorType = type,
+                               .descriptorCount = 1,
+                               .stageFlags = vk::ShaderStageFlagBits::eCompute};
+            ++count;
+        }
+        set_layout = Check<"create HDR native descriptor set layout">(
+            device.createDescriptorSetLayoutUnique({
+                .flags = vk::DescriptorSetLayoutCreateFlagBits::ePushDescriptorKHR,
+                .bindingCount = count,
+                .pBindings = bindings.data(),
+            }));
+        const vk::PushConstantRange push{
+            .stageFlags = vk::ShaderStageFlagBits::eCompute, .offset = 0, .size = push_size};
+        pipeline_layout = Check<"create HDR native pipeline layout">(
+            device.createPipelineLayoutUnique({
+                .setLayoutCount = 1,
+                .pSetLayouts = &*set_layout,
+                .pushConstantRangeCount = push_size ? 1u : 0u,
+                .pPushConstantRanges = push_size ? &push : nullptr,
+            }));
+        const auto module = CompileSPV(code, device);
+        ASSERT(module);
+        SetObjectName(device, module, name);
+        pipeline = Check<"create HDR native pipeline">(device.createComputePipelineUnique(
+            {}, vk::ComputePipelineCreateInfo{
+                    .stage = {.stage = vk::ShaderStageFlagBits::eCompute,
+                              .module = module,
+                              .pName = "main"},
+                    .layout = *pipeline_layout,
+                }));
+        device.destroyShaderModule(module);
+    };
+    make({SampledImage, StorageImage}, 0, HDR_NATIVE_LUMA_COMP, "hdr_native.comp (luma)",
+         luma_layout, luma_pipeline_layout, luma_pipeline);
+    make({SampledImage, SampledImage, StorageBuffer, StorageBuffer}, sizeof(u32),
+         HDR_NATIVE_STATS_COMP, "hdr_native.comp (stats)", stats_layout, stats_pipeline_layout,
+         stats_pipeline);
+    make({SampledImage, SampledImage, StorageBuffer, StorageBuffer, StorageImage}, sizeof(u32),
+         HDR_NATIVE_SNAPSHOT_COMP, "hdr_native.comp (snapshot)", snapshot_layout,
+         snapshot_pipeline_layout, snapshot_pipeline);
+    make({StorageBuffer, StorageBuffer}, sizeof(ExposureParams), HDR_NATIVE_EXPOSURE_COMP,
+         "hdr_native.comp (exposure)", exposure_layout, exposure_pipeline_layout,
+         exposure_pipeline);
+    make({SampledImage, SampledImage, SampledImage, StorageBuffer, StorageImage},
+         sizeof(GainParams), HDR_NATIVE_GAIN_COMP, "hdr_native.comp (gain)", gain_layout,
+         gain_pipeline_layout, gain_pipeline);
+}
+
+vk::ImageView HdrNative::CachedView(const VideoCore::Image& image, vk::Format format) {
+    // As TemporalUpscaler::CachedView: the scene color and the UI target stay the same images
+    // frame after frame; a view per frame would be created and destroyed for nothing.
+    const vk::Image handle = image.GetImage();
+    ViewEntry* oldest = &view_cache[0];
+    for (auto& entry : view_cache) {
+        if (entry.view && entry.image == handle && entry.uid == image.image_uid &&
+            entry.format == format) {
+            entry.last_use = ++view_uses;
+            return entry.view;
+        }
+        if (entry.last_use < oldest->last_use) {
+            oldest = &entry;
+        }
+    }
+    const auto device = instance.GetDevice();
+    if (oldest->view) {
+        scheduler.DeferOperation([device, view = oldest->view] { device.destroyImageView(view); });
+    }
+    // Sampled only: the guest image may also be a storage image, which an sRGB view cannot be.
+    const vk::ImageViewUsageCreateInfo usage{.usage = vk::ImageUsageFlagBits::eSampled};
+    *oldest = {
+        .image = handle,
+        .uid = image.image_uid,
+        .format = format,
+        .view = Check<"create HDR native view">(device.createImageView({
+            .pNext = &usage,
+            .image = handle,
+            .viewType = vk::ImageViewType::e2D,
+            .format = format,
+            .subresourceRange = ColorRange,
+        })),
+        .last_use = ++view_uses,
+    };
+    return oldest->view;
+}
+
+HdrNative::Source HdrNative::Guest(VideoCore::ImageId id, vk::Format format) {
+    auto& image = texture_cache.GetImage(id);
+    const vk::ImageView view = CachedView(image, format);
+    scheduler.EndRendering();
+    // NativeAccess (in Transit) resolves a reduced-size scene proxy into the image first, as the
+    // game's own compute passes reading it do.
+    runtime.Transit(&image, vk::ImageLayout::eGeneral, Compute, vk::AccessFlagBits2::eShaderRead);
+    runtime.FlushBarriers();
+    return {image.GetImage(), view, image.info.size.width, image.info.size.height};
+}
+
+void HdrNative::EnsureImage(OwnImage& own, u32 width, u32 height, vk::Format format,
+                            const char* name) {
+    if (own.image && own.width == width && own.height == height) {
+        return;
+    }
+    if (own.image) {
+        // Recorded passes may still read the old size's image.
+        scheduler.DeferOperation(
+            [image = std::move(own.image), view = std::move(own.view)]() mutable {
+                view.reset();
+                image.Destroy();
+            });
+    }
+    const auto device = instance.GetDevice();
+    own.image = VideoCore::UniqueImage(device, instance.GetAllocator());
+    own.image.Create(vk::ImageCreateInfo{
+        .imageType = vk::ImageType::e2D,
+        .format = format,
+        .extent = {width, height, 1},
+        .mipLevels = 1,
+        .arrayLayers = 1,
+        .samples = vk::SampleCountFlagBits::e1,
+        .tiling = vk::ImageTiling::eOptimal,
+        .usage = vk::ImageUsageFlagBits::eStorage | vk::ImageUsageFlagBits::eSampled,
+        .initialLayout = vk::ImageLayout::eUndefined,
+    });
+    SetObjectName(device, vk::Image(own.image), "HDR native {}", name);
+    own.view = Check<"create HDR native image view">(device.createImageViewUnique({
+        .image = vk::Image(own.image),
+        .viewType = vk::ImageViewType::e2D,
+        .format = format,
+        .subresourceRange = ColorRange,
+    }));
+    own.width = width;
+    own.height = height;
+}
+
+void HdrNative::EnsureGainMap(std::unique_ptr<HdrGainMap>& map, u32 width, u32 height) {
+    if (map && map->width == width && map->height == height) {
+        return;
+    }
+    if (map) {
+        // The output size changed. A map handed back by the presenter is idle (its frame's
+        // fence was waited); one made at an earlier display pass may still be written.
+        scheduler.DeferOperation([old = std::move(map)]() mutable { old.reset(); });
+    }
+    const auto device = instance.GetDevice();
+    map = std::make_unique<HdrGainMap>();
+    map->image = VideoCore::UniqueImage(device, instance.GetAllocator());
+    map->image.Create(vk::ImageCreateInfo{
+        .imageType = vk::ImageType::e2D,
+        .format = vk::Format::eR16Sfloat,
+        .extent = {width, height, 1},
+        .mipLevels = 1,
+        .arrayLayers = 1,
+        .samples = vk::SampleCountFlagBits::e1,
+        .tiling = vk::ImageTiling::eOptimal,
+        .usage = vk::ImageUsageFlagBits::eStorage | vk::ImageUsageFlagBits::eSampled,
+        .initialLayout = vk::ImageLayout::eUndefined,
+    });
+    SetObjectName(device, vk::Image(map->image), "HDR native gain map");
+    map->view = Check<"create HDR gain map view">(device.createImageViewUnique({
+        .image = vk::Image(map->image),
+        .viewType = vk::ImageViewType::e2D,
+        .format = vk::Format::eR16Sfloat,
+        .subresourceRange = ColorRange,
+    }));
+    map->width = width;
+    map->height = height;
+}
+
+void HdrNative::EnsurePartials(u32 groups) {
+    const vk::DeviceSize size = vk::DeviceSize(std::max(groups, 1u)) * 4 * sizeof(float);
+    if (partials.buffer && partials.size >= size) {
+        return;
+    }
+    if (partials.buffer) {
+        scheduler.DeferOperation([allocator = instance.GetAllocator(), old = partials] {
+            vmaDestroyBuffer(allocator, old.buffer, old.allocation);
+        });
+    }
+    const VkBufferCreateInfo buffer_ci{
+        .sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO,
+        .size = size,
+        .usage = VK_BUFFER_USAGE_STORAGE_BUFFER_BIT,
+    };
+    const VmaAllocationCreateInfo alloc_ci{.usage = VMA_MEMORY_USAGE_AUTO_PREFER_DEVICE};
+    VkBuffer buffer{};
+    const VkResult result = vmaCreateBuffer(instance.GetAllocator(), &buffer_ci, &alloc_ci,
+                                            &buffer, &partials.allocation, nullptr);
+    ASSERT_MSG(result == VK_SUCCESS, "HDR native: statistics buffer allocation failed");
+    partials.buffer = vk::Buffer{buffer};
+    partials.size = size;
+}
+
+void HdrNative::OnSceneColor(VideoCore::ImageId id) {
+    if (luma_ready || !id || !Wanted()) {
+        return;
+    }
+    const auto& image = texture_cache.GetImage(id);
+    if (image.info.pixel_format != vk::Format::eR16G16B16A16Sfloat) {
+        static bool printed = false;
+        PrintOnce(printed, "HDR native: the scene color is not RGBA16F; native mode falls back");
+        return;
+    }
+    // A reduced scene's resolve (in Guest) counts as the game's: the post would do it anyway.
+    const Source scene = Guest(id, vk::Format::eR16G16B16A16Sfloat);
+    auto* profiler = GpuProfiler::Get();
+    const u64 resume = profiler ? profiler->Current() : 0;
+    if (profiler) {
+        profiler->Mark(0x4D52'0001ull, [] { return std::string{"HDR native: scene luma"}; });
+    }
+    const u32 width = (scene.width + 1) / 2, height = (scene.height + 1) / 2;
+    EnsureImage(luma, width, height, vk::Format::eR16G16Sfloat, "scene luma");
+    scheduler.RecordCrumb(
+        {.name = "HDR native scene luma"},
+        [scene_view = scene.view, image = vk::Image(luma.image), view = *luma.view, width, height,
+         pipeline = *luma_pipeline, layout = *luma_pipeline_layout](vk::CommandBuffer cmdbuf) {
+            BeforeCompute(cmdbuf);
+            const auto to_write = ToWrite(image);
+            cmdbuf.pipelineBarrier2(
+                {.imageMemoryBarrierCount = 1, .pImageMemoryBarriers = &to_write});
+            const std::array infos{Sampled(scene_view), Sampled(view)};
+            const std::array writes{Write(0, SampledImage, &infos[0]),
+                                    Write(1, StorageImage, &infos[1])};
+            cmdbuf.bindPipeline(vk::PipelineBindPoint::eCompute, pipeline);
+            cmdbuf.pushDescriptorSetKHR(vk::PipelineBindPoint::eCompute, layout, 0, writes);
+            cmdbuf.dispatch((width + 7) / 8, (height + 7) / 8, 1);
+            AfterCompute(cmdbuf);
+        });
+    if (resume) {
+        profiler->Resume(resume);
+    }
+    luma_ready = true;
+}
+
+void HdrNative::OnUiStart(const Source& frame) {
+    if (!WantsUiStart()) {
+        return;
+    }
+    ui_started = true;
+    if (!frame.view || !frame.width || !frame.height || !Wanted()) {
+        return;
+    }
+    EnsureImage(snapshot, frame.width, frame.height, vk::Format::eR8G8B8A8Unorm,
+                "frame before UI");
+    RecordExposure(frame, true);
+    snapshot_ready = true;
+    snapshot_source = frame.image;
+}
+
+void HdrNative::RecordExposure(const Source& frame, bool copy) {
+    auto* profiler = GpuProfiler::Get();
+    const u64 resume = profiler ? profiler->Current() : 0;
+    if (profiler) {
+        profiler->Mark(0x4D52'0002ull, [] { return std::string{"HDR native: exposure"}; });
+    }
+    const u32 groups_x = (frame.width + 15) / 16, groups_y = (frame.height + 15) / 16;
+    EnsurePartials(groups_x * groups_y);
+    const ExposureParams params{
+        .count = groups_x * groups_y,
+        .reset = measured_last_frame ? 0u : 1u,
+        .min_samples = float(std::max(1024u, frame.width * frame.height / MinSampleShare)),
+        .rate = ExposureRate,
+    };
+    const bool clear_state = !state_cleared;
+    state_cleared = true;
+    scheduler.EndRendering();
+    scheduler.RecordCrumb(
+        {.name = "HDR native exposure"},
+        [frame_view = frame.view, luma = *luma.view, snapshot_image = vk::Image(snapshot.image),
+         snapshot_view = copy ? *snapshot.view : vk::ImageView{}, partials = partials.buffer,
+         partials_size = partials.size, state = state.buffer, groups_x, groups_y, params,
+         clear_state, stats = copy ? *snapshot_pipeline : *stats_pipeline,
+         stats_layout = copy ? *snapshot_pipeline_layout : *stats_pipeline_layout,
+         exposure = *exposure_pipeline,
+         exposure_layout = *exposure_pipeline_layout](vk::CommandBuffer cmdbuf) {
+            if (clear_state) {
+                cmdbuf.fillBuffer(state, 0, StateSize, 0);
+                const vk::MemoryBarrier2 cleared{
+                    .srcStageMask = vk::PipelineStageFlagBits2::eTransfer,
+                    .srcAccessMask = vk::AccessFlagBits2::eTransferWrite,
+                    .dstStageMask = Compute,
+                    .dstAccessMask = vk::AccessFlagBits2::eShaderRead |
+                                     vk::AccessFlagBits2::eShaderWrite,
+                };
+                cmdbuf.pipelineBarrier2({.memoryBarrierCount = 1, .pMemoryBarriers = &cleared});
+            }
+            BeforeCompute(cmdbuf);
+            if (snapshot_view) {
+                const auto to_write = ToWrite(snapshot_image);
+                cmdbuf.pipelineBarrier2(
+                    {.imageMemoryBarrierCount = 1, .pImageMemoryBarriers = &to_write});
+            }
+            const std::array infos{Sampled(frame_view), Sampled(luma), Sampled(snapshot_view)};
+            const vk::DescriptorBufferInfo partials_info{partials, 0, partials_size};
+            const vk::DescriptorBufferInfo state_info{state, 0, StateSize};
+            const std::array writes{Write(0, SampledImage, &infos[0]),
+                                    Write(1, SampledImage, &infos[1]),
+                                    Write(2, StorageBuffer, nullptr, &partials_info),
+                                    Write(3, StorageBuffer, nullptr, &state_info),
+                                    Write(4, StorageImage, &infos[2])};
+            cmdbuf.bindPipeline(vk::PipelineBindPoint::eCompute, stats);
+            cmdbuf.pushDescriptorSetKHR(vk::PipelineBindPoint::eCompute, stats_layout, 0,
+                                        vk::ArrayProxy<const vk::WriteDescriptorSet>(
+                                            snapshot_view ? 5u : 4u, writes.data()));
+            cmdbuf.pushConstants(stats_layout, vk::ShaderStageFlagBits::eCompute, 0,
+                                 sizeof(params.reset), &params.reset);
+            cmdbuf.dispatch(groups_x, groups_y, 1);
+            // The partial sums, added up by one group, which then updates the state the
+            // groups above read.
+            const vk::MemoryBarrier2 summed{
+                .srcStageMask = Compute,
+                .srcAccessMask = vk::AccessFlagBits2::eShaderWrite,
+                .dstStageMask = Compute,
+                .dstAccessMask = vk::AccessFlagBits2::eShaderRead,
+            };
+            cmdbuf.pipelineBarrier2({.memoryBarrierCount = 1, .pMemoryBarriers = &summed});
+            const std::array exposure_writes{Write(0, StorageBuffer, nullptr, &partials_info),
+                                             Write(1, StorageBuffer, nullptr, &state_info)};
+            cmdbuf.bindPipeline(vk::PipelineBindPoint::eCompute, exposure);
+            cmdbuf.pushDescriptorSetKHR(vk::PipelineBindPoint::eCompute, exposure_layout, 0,
+                                        exposure_writes);
+            cmdbuf.pushConstants(exposure_layout, vk::ShaderStageFlagBits::eCompute, 0,
+                                 sizeof(params), &params);
+            cmdbuf.dispatch(1, 1, 1);
+            AfterCompute(cmdbuf);
+        });
+    if (resume) {
+        profiler->Resume(resume);
+    }
+}
+
+void HdrNative::RecordGain(const Source& frame, const Source& before_ui, const HdrGainMap& map) {
+    auto* profiler = GpuProfiler::Get();
+    const u64 resume = profiler ? profiler->Current() : 0;
+    if (profiler) {
+        profiler->Mark(0x4D52'0003ull, [] { return std::string{"HDR native: gain map"}; });
+    }
+    const auto& s = BbSettings::Get();
+    const float paper_white = std::clamp(s.hdr_paper_white.load(), BbSettings::HdrPaperWhiteMin,
+                                         BbSettings::HdrPaperWhiteMax);
+    const float peak =
+        std::clamp(s.hdr_peak.load(), BbSettings::HdrPeakMin, BbSettings::HdrPeakMax);
+    // Boost in native mode: the share of the scene's highlight range shown, in log2. Its square
+    // root, so the shared default (0.25, chosen for expand mode) shows half of it: a lamp the
+    // scene has 10x brighter than SDR white comes out 3.2x.
+    const GainParams params{
+        .strength = std::sqrt(std::clamp(s.hdr_boost.load(), 0.0f, 1.0f)),
+        .white = peak / paper_white,
+        .knee = Knee,
+        .unused = 0.0f,
+    };
+    scheduler.EndRendering();
+    scheduler.RecordCrumb(
+        {.name = "HDR native gain map"},
+        [frame_view = frame.view, before_view = before_ui.view, luma = *luma.view,
+         state = state.buffer, image = vk::Image(map.image), view = *map.view, width = map.width,
+         height = map.height, params, pipeline = *gain_pipeline,
+         layout = *gain_pipeline_layout](vk::CommandBuffer cmdbuf) {
+            BeforeCompute(cmdbuf);
+            const auto to_write = ToWrite(image);
+            cmdbuf.pipelineBarrier2(
+                {.imageMemoryBarrierCount = 1, .pImageMemoryBarriers = &to_write});
+            const std::array infos{Sampled(frame_view), Sampled(before_view), Sampled(luma),
+                                   Sampled(view)};
+            const vk::DescriptorBufferInfo state_info{state, 0, StateSize};
+            const std::array writes{Write(0, SampledImage, &infos[0]),
+                                    Write(1, SampledImage, &infos[1]),
+                                    Write(2, SampledImage, &infos[2]),
+                                    Write(3, StorageBuffer, nullptr, &state_info),
+                                    Write(4, StorageImage, &infos[3])};
+            cmdbuf.bindPipeline(vk::PipelineBindPoint::eCompute, pipeline);
+            cmdbuf.pushDescriptorSetKHR(vk::PipelineBindPoint::eCompute, layout, 0, writes);
+            cmdbuf.pushConstants(layout, vk::ShaderStageFlagBits::eCompute, 0, sizeof(params),
+                                 &params);
+            cmdbuf.dispatch((width + 7) / 8, (height + 7) / 8, 1);
+            // Read by the HDR encode on the present thread's submission, which waits for this
+            // frame's work (Presenter::Present); in General layout, sampled.
+            const vk::ImageMemoryBarrier2 to_read{
+                .srcStageMask = Compute,
+                .srcAccessMask = vk::AccessFlagBits2::eShaderStorageWrite,
+                .dstStageMask = vk::PipelineStageFlagBits2::eFragmentShader,
+                .dstAccessMask = vk::AccessFlagBits2::eShaderSampledRead,
+                .oldLayout = vk::ImageLayout::eGeneral,
+                .newLayout = vk::ImageLayout::eGeneral,
+                .image = image,
+                .subresourceRange = ColorRange,
+            };
+            cmdbuf.pipelineBarrier2(
+                {.imageMemoryBarrierCount = 1, .pImageMemoryBarriers = &to_read});
+            AfterCompute(cmdbuf);
+        });
+    if (resume) {
+        profiler->Resume(resume);
+    }
+}
+
+void HdrNative::OnDisplayPass(VAddr address, const Source& frame) {
+    bool made = false;
+    bool measured = snapshot_ready;
+    if (luma_ready && frame.view && frame.width && frame.height && Wanted()) {
+        // With a UI-free copy the display pass must read the image it was taken from, at the
+        // same size; without a UI pass this frame (in-engine cutscenes) the frame has no UI and
+        // is its own copy. A UI pass without a copy (its target not found): no map, the UI
+        // must not be brightened.
+        const bool matches = snapshot_ready ? snapshot_source == frame.image &&
+                                                  snapshot.width == frame.width &&
+                                                  snapshot.height == frame.height
+                                            : !ui_started;
+        if (matches) {
+            if (!snapshot_ready) {
+                RecordExposure(frame, false);
+                measured = true;
+            }
+            const Source before_ui =
+                snapshot_ready ? Source{vk::Image(snapshot.image), *snapshot.view, snapshot.width,
+                                        snapshot.height}
+                               : frame;
+            std::scoped_lock lock{slots_mutex};
+            auto& slot = slots[address];
+            EnsureGainMap(slot.map, frame.width, frame.height);
+            RecordGain(frame, before_ui, *slot.map);
+            slot.valid = true;
+            made = true;
+        } else {
+            static bool printed = false;
+            PrintOnce(printed, "HDR native: no UI-free copy of the image the display pass reads "
+                               "(UI target not found); such frames fall back to expand");
+        }
+    }
+    if (!made) {
+        std::scoped_lock lock{slots_mutex};
+        if (const auto it = slots.find(address); it != slots.end()) {
+            it->second.valid = false;
+        }
+    }
+    measured_last_frame = measured;
+    EndFrame();
+}
+
+bool HdrNative::TakeGainMap(VAddr address, std::unique_ptr<HdrGainMap>& map) {
+    std::scoped_lock lock{slots_mutex};
+    const auto it = slots.find(address);
+    if (it == slots.end() || !it->second.valid || !it->second.map) {
+        return false;
+    }
+    std::swap(map, it->second.map);
+    it->second.valid = false;
+    return true;
+}
+
+void HdrNative::EndFrame() {
+    luma_ready = false;
+    ui_started = false;
+    snapshot_ready = false;
+    snapshot_source = vk::Image{};
+}
+
+} // namespace Vulkan
diff --git a/gpu/shadps4/video_core/renderer_vulkan/vk_hdr_native.h b/gpu/shadps4/video_core/renderer_vulkan/vk_hdr_native.h
new file mode 100644
index 0000000..c607d38
--- /dev/null
+++ b/gpu/shadps4/video_core/renderer_vulkan/vk_hdr_native.h
@@ -0,0 +1,159 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// bbport: native HDR output (hdr_mode=native, docs/hdr.md). The HDR encode (hdr_output.frag)
+// shows the game's finished SDR frame, UI included; native mode brightens its highlights by how
+// much brighter the game's own linear HDR scene is where the tonemap compressed them, measured
+// per frame on the GPU (hdr_native.comp) at three points of Bloodborne's frame that the temporal
+// upscaler already finds (vk_temporal_upscaler.h):
+// - before the post-processing combine (compute shader 9a9cf8a9, after the upscaler wrote its
+//   output into the scene color): the scene's brightest channel at half size (OnSceneColor);
+// - at the first UI pass (the first Scaleform draw, vertex shader 34e8a281 or another of
+//   UiComposition::MovieShader; with the scaled presets the upscaled output-size UI image): a
+//   copy of the tonemapped frame before any UI pixel, and the exposure the game's curve gave the
+//   midtones (OnUiStart);
+// - at the display pass that copies the finished frame into a display buffer (the first pass of
+//   the next frame): the gain map, 1 below the knee and where the frame differs from the copy
+//   (UI). It belongs to that display buffer: the presenter takes it when the buffer is flipped,
+//   which comes a frame later in the command stream, so a frame and its map always match.
+// A frame missing any of them (title, menus, loading, movies) has no map: the encode falls back
+// to expand mode for it. All passes are recorded on the recording threads (Scheduler::Record), a
+// handful of dispatches per frame, nothing per draw; no readback and no wait.
+
+#pragma once
+
+#include <array>
+#include <memory>
+#include <mutex>
+#include <unordered_map>
+
+#include "common/types.h"
+#include "video_core/renderer_vulkan/vk_common.h"
+#include "video_core/texture_cache/image.h"
+
+namespace VideoCore {
+class TextureCache;
+}
+
+namespace Vulkan {
+
+class Instance;
+class Scheduler;
+class Runtime;
+
+/// A display buffer's gain map: R16F at the finished frame's size, General layout; negative
+/// where the frame had UI (magnitude 1 there). Handed from the display pass to the presenter's
+/// Frame by exchange (HdrNative::TakeGainMap), never copied.
+struct HdrGainMap {
+    VideoCore::UniqueImage image;
+    vk::UniqueImageView view;
+    u32 width = 0, height = 0;
+};
+
+class HdrNative {
+public:
+    HdrNative(const Instance& instance, Scheduler& scheduler,
+              VideoCore::TextureCache& texture_cache, Runtime& runtime);
+    ~HdrNative();
+
+    /// Native mode is in use: an HDR swapchain is presented and hdr_mode is native. Otherwise
+    /// nothing is recorded.
+    [[nodiscard]] static bool Wanted();
+
+    /// An image a pass reads: in General layout by the time the commands run, `view` sampled
+    /// (UNORM for the display-encoded frames).
+    struct Source {
+        vk::Image image;
+        vk::ImageView view;
+        u32 width = 0, height = 0;
+    };
+    /// A guest image as a Source: transitioned by the runtime (a reduced-size scene proxy is
+    /// resolved into it first), viewed as `format`.
+    Source Guest(VideoCore::ImageId id, vk::Format format);
+
+    /// Before the post-processing combine: the scene color (RGBA16F), upscaled by now. Once a
+    /// frame.
+    void OnSceneColor(VideoCore::ImageId scene);
+    /// The first UI pass is next and this frame's scene was seen: OnUiStart is wanted.
+    [[nodiscard]] bool WantsUiStart() const noexcept {
+        return luma_ready && !ui_started;
+    }
+    /// The tonemapped frame before the first UI pass (empty: none found). Once a frame.
+    void OnUiStart(const Source& frame);
+    /// The display pass copying the finished frame `frame` (empty: none) into the display buffer
+    /// at `address`: its gain map, or none. Ends the frame.
+    void OnDisplayPass(VAddr address, const Source& frame);
+
+    /// Presenter, when the display buffer at `address` is flipped: exchanges `map` with the gain
+    /// map made for it, if it has one (then true). The display buffer's slot gets the old map
+    /// (`map` may be null): the frame it came from has been presented (its fence waited).
+    bool TakeGainMap(VAddr address, std::unique_ptr<HdrGainMap>& map);
+
+private:
+    struct OwnImage {
+        VideoCore::UniqueImage image;
+        vk::UniqueImageView view;
+        u32 width = 0, height = 0;
+    };
+    struct Buffer {
+        vk::Buffer buffer{};
+        VmaAllocation allocation{};
+        vk::DeviceSize size = 0;
+    };
+    struct Slot {
+        std::unique_ptr<HdrGainMap> map;
+        bool valid = false; ///< made for the frame the display buffer holds now
+    };
+
+    void CreatePipelines();
+    /// (Re)creates `image` at `width` x `height`; the old one goes once the GPU is past it.
+    void EnsureImage(OwnImage& image, u32 width, u32 height, vk::Format format, const char* name);
+    void EnsureGainMap(std::unique_ptr<HdrGainMap>& map, u32 width, u32 height);
+    /// Room for `groups` partial sums of the STATS pass.
+    void EnsurePartials(u32 groups);
+    /// The exposure statistics of `frame` against this frame's luma (`copy`: also copying it
+    /// into the snapshot), then the exposure update.
+    void RecordExposure(const Source& frame, bool copy);
+    void RecordGain(const Source& frame, const Source& before_ui, const HdrGainMap& map);
+    vk::ImageView CachedView(const VideoCore::Image& image, vk::Format format);
+    void EndFrame();
+
+    const Instance& instance;
+    Scheduler& scheduler;
+    VideoCore::TextureCache& texture_cache;
+    Runtime& runtime;
+
+    vk::UniqueDescriptorSetLayout luma_layout, stats_layout, snapshot_layout, exposure_layout,
+        gain_layout;
+    vk::UniquePipelineLayout luma_pipeline_layout, stats_pipeline_layout,
+        snapshot_pipeline_layout, exposure_pipeline_layout, gain_pipeline_layout;
+    vk::UniquePipeline luma_pipeline, stats_pipeline, snapshot_pipeline, exposure_pipeline,
+        gain_pipeline;
+
+    OwnImage luma;     ///< RG16F, half the scene's size: the brightest channel's 2x2 max, average
+    OwnImage snapshot; ///< RGBA8, the tonemapped frame before the UI
+    Buffer partials;   ///< vec2 per STATS group
+    Buffer state;      ///< hdr_native.comp's Exposure, zero at start
+    bool state_cleared = false;
+    /// The exposure was measured in the last frame (else the next measurement replaces it).
+    bool measured_last_frame = false;
+
+    // This frame (from one display pass to the next), on the draw recording thread.
+    bool luma_ready = false;     ///< the scene was reduced
+    bool ui_started = false;     ///< OnUiStart was called
+    bool snapshot_ready = false; ///< the UI-free copy and the exposure were taken
+    vk::Image snapshot_source{}; ///< the image they were taken from
+
+    std::mutex slots_mutex; ///< TakeGainMap runs where the flip is handled
+    std::unordered_map<VAddr, Slot> slots;
+
+    struct ViewEntry {
+        vk::Image image;
+        u64 uid = 0;
+        vk::Format format{};
+        vk::ImageView view;
+        u64 last_use = 0;
+    };
+    std::array<ViewEntry, 4> view_cache{};
+    u64 view_uses = 0;
+};
+
+} // namespace Vulkan
diff --git a/gpu/shadps4/video_core/renderer_vulkan/vk_occlusion.cpp b/gpu/shadps4/video_core/renderer_vulkan/vk_occlusion.cpp
new file mode 100644
index 0000000..1cdcd2d
--- /dev/null
+++ b/gpu/shadps4/video_core/renderer_vulkan/vk_occlusion.cpp
@@ -0,0 +1,481 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// bbport: real occlusion query results (vk_occlusion.h). Design after droogie/bbhost b68ed17.
+
+#include <algorithm>
+#include <array>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+#include "bbport_toggles.h"
+#include "core/memory.h"
+#include "video_core/renderer_vulkan/occlusion_model.h"
+#include "video_core/renderer_vulkan/scene_resolution.h"
+#include "video_core/renderer_vulkan/vk_instance.h"
+#include "video_core/renderer_vulkan/vk_occlusion.h"
+#include "video_core/renderer_vulkan/vk_rasterizer.h"
+#include "video_core/renderer_vulkan/vk_scheduler.h"
+
+extern "C" void runtime_memory_read_backing(uintptr_t address, void* data, uint64_t size);
+
+namespace Vulkan {
+
+namespace {
+using OcclusionModel::MaxPipes;
+using OcclusionModel::Share;
+using OcclusionModel::Unmeasured;
+using OcclusionModel::ValidBit;
+
+u64 EnvU64(const char* name, u64 fallback) {
+    const char* env = std::getenv(name);
+    return env && *env ? std::strtoull(env, nullptr, 10) : fallback;
+}
+
+/// Reads guest memory through the runtime's backing view: no page protection (a read fault on
+/// this thread would wait for the GPU thread), zeroes where nothing is mapped.
+void ReadGuest(VAddr address, void* data, u64 size) {
+    runtime_memory_read_backing(address, data, size);
+}
+
+/// A Gnm block as the game reads it now.
+OcclusionModel::Block ReadBlock(VAddr block, u32 pipes) {
+    std::array<u64, 2 * MaxPipes> words{};
+    ReadGuest(block, words.data(), 16ull * pipes);
+    return OcclusionModel::ReadBlock(words.data(), pipes);
+}
+} // namespace
+
+struct Occlusion::Shared {
+    /// The resolver's state and the pool's life (the destructor takes it too).
+    std::mutex mutex;
+    /// Only the queue: the recording side never waits for a resolve in progress.
+    std::mutex queue_mutex;
+    bool alive = true;
+    vk::Device device;
+    vk::QueryPool pool;
+    Rasterizer* rasterizer = nullptr;
+    bool precise = false;
+    u64 max_lag = 3;
+
+    struct Pending {
+        u64 tick;   ///< the submission holding the dump (and every query before it)
+        VAddr va;
+        u64 frame;
+        u64 serial;
+        u64 first;  ///< the interval's first query, as a running count
+        u32 count;  ///< its queries
+        u32 pipes;
+        bool poison; ///< a draw in the interval got no query
+    };
+    std::deque<Pending> pending; ///< under queue_mutex
+    std::vector<Pending> ready;  ///< taken from it by the resolver
+    /// Per query: the sample scale of its draw (16.16; reduced scene targets), written by the
+    /// recording side before the dump is queued under the mutex.
+    std::array<u32, PoolSize> scale{};
+    std::atomic<u64> released{0};        ///< queries read and reset (reusable)
+    std::atomic<u64> resolved_serial{0}; ///< dumps processed, in order
+
+    u64 total = 0; ///< the DBs' running count
+    /// What we last wrote at each dump address: our own value may be overwritten (a block the
+    /// game reuses), anything else that is not zero is not ours to write over.
+    std::unordered_map<VAddr, u64> written;
+    /// Begin dumps (+0) written in this use of their block: the total they wrote, taken by the
+    /// block's end dump (+8) for the block's result.
+    std::unordered_map<VAddr, u64> begins;
+    /// Per block (its +0 address): the hysteresis of its results (OcclusionModel::BlockHistory).
+    std::unordered_map<VAddr, OcclusionModel::BlockHistory> histories;
+    std::vector<u64> results;
+
+    // Statistics (BB_FRAME_STATS), under the mutex except the recording side's atomics.
+    u64 dumps = 0, queries = 0, unavailable = 0, poisoned = 0, visible = 0, occluded = 0;
+    u64 late = 0, foreign = 0, unbacked = 0, written_dumps = 0;
+    u64 held_visible = 0; ///< blocks that measured nothing but read visible (hysteresis)
+    u64 late_written = 0; ///< late dumps of known blocks written all the same
+    std::atomic<u64> pool_full{0}, pred_sets{0}, pred_resolved{0}, pred_skipped{0},
+        pred_drawn{0};
+    std::chrono::steady_clock::time_point window = std::chrono::steady_clock::now();
+    u64 window_frames = 0, window_draws = 0;
+    std::array<u64, 14> last{};
+
+    void Resolve(u64 tick);
+    void Process(const Pending& dump);
+    /// The end dump of `block` (its +0 address) is about to be written: hysteresis.
+    void HoldVisible(VAddr block);
+    /// False when it did not land (not a query block now, or unmapped).
+    bool WriteBlock(const Pending& dump);
+    void Report();
+};
+
+bool Occlusion::Wanted() {
+    static const bool on = [] {
+        const char* env = std::getenv("BB_OCCLUSION");
+        return !(env && env[0] == '0');
+    }();
+    return on;
+}
+
+Occlusion::Occlusion(const Instance& instance_, Scheduler& scheduler_, Rasterizer& rasterizer_)
+    : instance{instance_}, scheduler{scheduler_}, rasterizer{rasterizer_} {}
+
+std::unique_ptr<Occlusion> Occlusion::Create(const Instance& instance, Scheduler& scheduler,
+                                             Rasterizer& rasterizer) {
+    if (!Wanted()) {
+        std::printf("Occlusion: off (BB_OCCLUSION=0): every query the game makes reads visible\n");
+        return nullptr;
+    }
+    std::unique_ptr<Occlusion> occlusion{new Occlusion(instance, scheduler, rasterizer)};
+    if (!occlusion->Init()) {
+        return nullptr;
+    }
+    return occlusion;
+}
+
+bool Occlusion::Init() {
+    // Results are read and the queries reset on the CPU once the GPU is past them: no reset
+    // commands outside render passes, no waits.
+    if (!instance.IsHostQueryResetSupported()) {
+        std::printf("Occlusion: off - the device has no host query reset; every query the game "
+                    "makes reads visible, as before\n");
+        return false;
+    }
+    const vk::Device device = instance.GetDevice();
+    const vk::QueryPoolCreateInfo info = {
+        .queryType = vk::QueryType::eOcclusion,
+        .queryCount = PoolSize,
+    };
+    const auto [result, pool] = device.createQueryPool(info);
+    if (result != vk::Result::eSuccess) {
+        std::printf("Occlusion: off - no query pool (%s); every query the game makes reads "
+                    "visible, as before\n",
+                    vk::to_string(result).c_str());
+        return false;
+    }
+    device.resetQueryPool(pool, 0, PoolSize);
+    precise = instance.IsOcclusionQueryPreciseSupported();
+    cap = static_cast<u32>(std::clamp<u64>(EnvU64("BB_OCCLUSION_CAP", 64), 1, 1024));
+    shared = std::make_shared<Shared>();
+    shared->device = device;
+    shared->pool = pool;
+    shared->rasterizer = &rasterizer;
+    shared->precise = precise;
+    shared->max_lag = EnvU64("BB_OCCLUSION_MAX_LAG", 3);
+    shared->results.resize(2ull * PoolSize);
+    std::printf("Occlusion: real sample counts (BB_OCCLUSION=0: the old always-visible fake) - a "
+                "query on each of the %u draws after a block's begin, results written when the "
+                "GPU has run them (at most %llu frames late), %s; SET_PREDICATION skips only on "
+                "known results\n",
+                cap, static_cast<unsigned long long>(shared->max_lag),
+                precise ? "precise" : "not precise (a nonzero count reads plainly visible)");
+    return true;
+}
+
+Occlusion::~Occlusion() {
+    if (!shared) {
+        return;
+    }
+    // A resolve still queued on the scheduler's thread finds it gone and does nothing.
+    std::scoped_lock lk{shared->mutex};
+    shared->alive = false;
+    shared->device.destroyQueryPool(shared->pool);
+    shared->pool = nullptr;
+}
+
+Occlusion::DumpTask Occlusion::MakeDump(VAddr va, u32 num_pipes) const noexcept {
+    return {va, issued, BbStats::submit_done_calls.load(std::memory_order_relaxed),
+            std::clamp(num_pipes, 1u, MaxPipes), 0};
+}
+
+void Occlusion::Dump(const DumpTask& task) {
+    // Every draw stage A decoded since the last dump got a query, or the interval reads visible:
+    // a draw dropped before recording (pipeline still compiling, filtered, failed) must not
+    // count as occluded.
+    const bool poison =
+        !interval.open || task.issued - interval.issued_at != interval.queries;
+    const u64 tick = scheduler.CurrentTick();
+    const u64 serial = ++dump_serial;
+    if (block_serial.size() > 65536) {
+        block_serial.clear();
+    }
+    block_serial[task.va & ~15ull] = serial;
+    {
+        std::scoped_lock lk{shared->queue_mutex};
+        shared->pending.push_back({tick, task.va, task.frame, serial, interval.first,
+                                   interval.queries, task.pipes, poison});
+    }
+    if (tick != registered_tick) {
+        // One resolve per submission, on the scheduler's thread once the GPU has finished it.
+        registered_tick = tick;
+        scheduler.DeferPriorityOperation(
+            [shared = shared, tick] { shared->Resolve(tick); });
+    }
+    // Gnm's begin dump (+0 of a 16-byte cell) measures the draws up to its end dump; after any
+    // other dump only the next draw is measured (droogie's caps), the rest read visible.
+    interval = {true, (task.va & 15) == 0 ? cap : 1u, 0, query_head, task.issued};
+    pipes = task.pipes;
+}
+
+Occlusion::DrawQuery Occlusion::AllocateQuery(u32 scene_size) noexcept {
+    if (query_head - shared->released.load(std::memory_order_acquire) >= PoolSize) {
+        shared->pool_full.fetch_add(1, std::memory_order_relaxed);
+        return {}; // unmeasured: reads visible
+    }
+    const u32 index = static_cast<u32>(query_head % PoolSize);
+    // A pass into the reduced scene targets counts fewer samples than the PS4's 1920x1080; the
+    // count is scaled back so a threshold the game applies means the same.
+    u32 scale = 1u << 16;
+    if (scene_size) {
+        const auto size = SceneResolution::Unpack(scene_size);
+        scale = OcclusionModel::SampleScale(size.width, size.height);
+    }
+    shared->scale[index] = scale;
+    ++query_head;
+    ++interval.queries;
+    return {shared->pool, index,
+            precise ? vk::QueryControlFlags{vk::QueryControlFlagBits::ePrecise}
+                    : vk::QueryControlFlags{}};
+}
+
+void Occlusion::SetPredication(const PredicationTask& task) {
+    shared->pred_sets.fetch_add(1, std::memory_order_relaxed);
+    if (task.op == 0) {
+        pred_mode = PredMode::None;
+        pred_visible = pred_unknown = false;
+        return;
+    }
+    if (task.op != 1) {
+        pred_mode = PredMode::Draw; // primitive-count predication (streamout): not emulated
+        return;
+    }
+    if (!(task.cont && pred_mode != PredMode::None)) {
+        pred_visible = pred_unknown = false;
+    }
+    // Known only when every dump into the block has been resolved: then the block holds this
+    // use's result (or is not ready). Results come a frame late, so mostly unknown: drawn.
+    const auto it = block_serial.find(task.block);
+    if (it != block_serial.end() &&
+        shared->resolved_serial.load(std::memory_order_acquire) >= it->second) {
+        const auto state = ReadBlock(task.block, pipes);
+        pred_unknown |= state == OcclusionModel::Block::NotReady;
+        pred_visible |= state == OcclusionModel::Block::Visible;
+        if (state != OcclusionModel::Block::NotReady) {
+            shared->pred_resolved.fetch_add(1, std::memory_order_relaxed);
+        }
+    } else {
+        pred_unknown = true;
+    }
+    // A wrong "occluded" makes geometry vanish: unknown draws.
+    const bool draw =
+        OcclusionModel::PredicatedDraws(pred_visible, pred_unknown, task.draw_if_visible != 0);
+    pred_mode = draw ? PredMode::Draw : PredMode::Skip;
+}
+
+bool Occlusion::SkipPredicated() noexcept {
+    if (pred_mode == PredMode::Skip) {
+        shared->pred_skipped.fetch_add(1, std::memory_order_relaxed);
+        return true;
+    }
+    shared->pred_drawn.fetch_add(1, std::memory_order_relaxed);
+    return false;
+}
+
+void Occlusion::Shared::Resolve(u64 tick) {
+    std::scoped_lock lk{mutex};
+    if (!alive) {
+        return;
+    }
+    ready.clear();
+    {
+        std::scoped_lock queue{queue_mutex};
+        while (!pending.empty() && pending.front().tick <= tick) {
+            ready.push_back(pending.front());
+            pending.pop_front();
+        }
+    }
+    for (const Pending& dump : ready) {
+        Process(dump);
+    }
+    Report();
+}
+
+void Occlusion::Shared::Process(const Pending& dump) {
+    ++dumps;
+    bool bad = dump.poison;
+    u64 samples = 0;
+    if (dump.count) {
+        queries += dump.count;
+        // The ring may wrap inside the interval: at most two ranges.
+        const u32 first = static_cast<u32>(dump.first % PoolSize);
+        const u32 head_part = std::min<u32>(dump.count, PoolSize - first);
+        const std::array<std::pair<u32, u32>, 2> ranges{{{first, head_part},
+                                                         {0, dump.count - head_part}}};
+        for (const auto& [start, count] : ranges) {
+            if (!count) {
+                continue;
+            }
+            // Without waiting: the GPU has finished the submission. A query a driver did not
+            // resolve (AMD while the window is unfocused, KyoPS4x #220) reads visible.
+            const vk::Result result = device.getQueryPoolResults(
+                pool, start, count, 16ull * count, results.data(), 16,
+                vk::QueryResultFlagBits::e64 | vk::QueryResultFlagBits::eWithAvailability);
+            for (u32 i = 0; i < count; ++i) {
+                const bool failed = result != vk::Result::eSuccess &&
+                                    result != vk::Result::eNotReady;
+                const bool available = !failed && results[2 * i + 1] != 0;
+                unavailable += available ? 0 : 1;
+                // Imprecise results may be 0/1 (NVIDIA): one sample read as "nearly hidden" was
+                // the likeliest cause of KyoPS4x #219's black world.
+                samples += OcclusionModel::Samples(results[2 * i], available, precise,
+                                                   scale[start + i]);
+            }
+            device.resetQueryPool(pool, start, count);
+        }
+        released.fetch_add(dump.count, std::memory_order_release);
+    }
+    if (bad) {
+        ++poisoned;
+        samples += Unmeasured;
+    }
+    total += samples;
+    const u64 lag = BbStats::submit_done_calls.load(std::memory_order_relaxed) - dump.frame;
+    const bool is_begin = (dump.va & 15) == 0;
+    // A late dump is written into a block we wrote before (it then holds the game's zeroes or
+    // our last value, checked by WriteBlock) up to twice the lag: the block keeps its last
+    // result instead of reading not ready. Later, or into memory we never wrote, the game may
+    // have freed and reused it by now: left as it is (not ready).
+    if (lag > max_lag && (lag > 2 * max_lag || !written.contains(dump.va))) {
+        ++late;
+        if (is_begin) {
+            begins.erase(dump.va);
+        }
+    } else {
+        late_written += lag > max_lag ? 1 : 0;
+        if ((dump.va & 15) == 8) {
+            HoldVisible(dump.va - 8);
+        }
+        const bool landed = WriteBlock(dump);
+        if (is_begin) {
+            if (landed) {
+                if (begins.size() > 65536) {
+                    begins.clear();
+                }
+                begins[dump.va] = total;
+            } else {
+                begins.erase(dump.va);
+            }
+        }
+    }
+    resolved_serial.store(dump.serial, std::memory_order_release);
+}
+
+void Occlusion::Shared::HoldVisible(VAddr block) {
+    // The block's result as the game reads it (end - begin): its begin dump must have landed
+    // in this use of the block, else the block reads not ready anyway.
+    const auto begin = begins.find(block);
+    if (begin == begins.end()) {
+        return;
+    }
+    const u64 measured = total - begin->second;
+    begins.erase(begin);
+    if (histories.size() > 65536) {
+        histories.clear();
+    }
+    const u64 reported = histories[block].Report(measured);
+    if (reported > measured) {
+        // Added to the running total: every block keeps reading end - begin.
+        total += reported - measured;
+        held_visible += measured == 0 ? 1 : 0;
+    }
+}
+
+bool Occlusion::Shared::WriteBlock(const Pending& dump) {
+    std::array<u64, 2 * MaxPipes> words{};
+    const u64 extent = 16ull * (dump.pipes - 1) + 8;
+    ReadGuest(dump.va, words.data(), extent);
+    const auto own = written.find(dump.va);
+    for (u32 k = 0; k < dump.pipes; ++k) {
+        const u64 word = words[2 * k];
+        const bool ours = own != written.end() &&
+                          word == (Share(own->second, dump.pipes, k) | ValidBit);
+        if (word != 0 && !ours) {
+            ++foreign;
+            return false; // neither the game's zeroes nor our last value: not a query block now
+        }
+    }
+    auto* memory = Core::Memory::Instance();
+    for (u32 k = 0; k < dump.pipes; ++k) {
+        const u64 value = Share(total, dump.pipes, k) | ValidBit;
+        auto* address = reinterpret_cast<u8*>(dump.va + 16ull * k);
+        // Through the backing view (no protection fault on this thread; fails rather than
+        // writing where nothing is mapped any more).
+        if (!memory->TryWriteBacking(address, &value, sizeof(value))) {
+            ++unbacked;
+            return false;
+        }
+        rasterizer->NoteLateCommandWrite(dump.va + 16ull * k, &value, sizeof(value));
+    }
+    ++written_dumps;
+    if (written.size() > 262144) {
+        written.clear();
+    }
+    written[dump.va] = total;
+    // The end dump of a Gnm block (+8): how the pair reads, for the statistics.
+    if ((dump.va & 15) == 8) {
+        if (const auto begin = written.find(dump.va - 8); begin != written.end()) {
+            ++(total != begin->second ? visible : occluded);
+        }
+    }
+    return true;
+}
+
+void Occlusion::Shared::Report() {
+    static const bool stats = std::getenv("BB_FRAME_STATS") != nullptr;
+    if (!stats) {
+        return;
+    }
+    const auto now = std::chrono::steady_clock::now();
+    const double seconds = std::chrono::duration<double>(now - window).count();
+    if (seconds < 5.0) {
+        return;
+    }
+    window = now;
+    const u64 frames_now = BbStats::submit_done_calls.load(std::memory_order_relaxed);
+    const u64 draws_now = BbStats::draws.load(std::memory_order_relaxed);
+    const std::array<u64, 14> now_counts{
+        dumps,
+        queries,
+        visible,
+        occluded,
+        poisoned,
+        unavailable,
+        late + foreign + unbacked,
+        pool_full.load(std::memory_order_relaxed),
+        pred_sets.load(std::memory_order_relaxed),
+        pred_resolved.load(std::memory_order_relaxed),
+        pred_skipped.load(std::memory_order_relaxed),
+        pred_drawn.load(std::memory_order_relaxed),
+        held_visible,
+        late_written,
+    };
+    std::array<double, 14> d{};
+    const double frames = std::max<double>(1.0, double(frames_now - window_frames));
+    for (size_t i = 0; i < d.size(); ++i) {
+        d[i] = double(now_counts[i] - last[i]) / frames;
+    }
+    const double pairs = d[2] + d[3];
+    std::printf("Occlusion per frame: %.1f dumps, %.1f queries, objects %.1f visible / %.1f "
+                "culled (%.0f%%), %.1f intervals read visible (%.1f queries unavailable), %.1f "
+                "dumps not written (totals: late %llu, reused memory %llu, unmapped %llu), pool "
+                "full %.1f; SET_PREDICATION %.1f (%.1f known), predicated draws %.1f skipped / "
+                "%.1f drawn; %.0f draws/frame; held visible %.1f, late written %.1f\n",
+                d[0], d[1], d[2], d[3], pairs > 0 ? 100.0 * d[3] / pairs : 0.0, d[4], d[5], d[6],
+                (unsigned long long)late, (unsigned long long)foreign,
+                (unsigned long long)unbacked, d[7], d[8], d[9], d[10], d[11],
+                double(draws_now - window_draws) / frames, d[12], d[13]);
+    std::fflush(stdout);
+    last = now_counts;
+    window_frames = frames_now;
+    window_draws = draws_now;
+}
+
+} // namespace Vulkan
diff --git a/gpu/shadps4/video_core/renderer_vulkan/vk_occlusion.h b/gpu/shadps4/video_core/renderer_vulkan/vk_occlusion.h
new file mode 100644
index 0000000..da1ac39
--- /dev/null
+++ b/gpu/shadps4/video_core/renderer_vulkan/vk_occlusion.h
@@ -0,0 +1,178 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// bbport: real occlusion query results (BB_OCCLUSION, default on; 0: the old fake counts).
+//
+// The design follows droogie/bbhost commit b68ed17 ("occlusion: the game's own GPU occlusion
+// culling works", Kyoskii, after KyoPS4x #217-#220), adapted to this renderer: there the GPU
+// writes the counts with a compute shader before the labels; here labels are written when the
+// work is recorded (not when the GPU has run it), so the counts are written by the CPU once the
+// GPU has finished the submission holding the queries, a frame or so after the game asked.
+//
+// The PS4 model: each depth block (DB, 8 on a base PS4) keeps a running count of the samples
+// that passed; an EVENT_WRITE of PIXEL_PIPE_STAT_DUMP / ZPASS_DONE stores every DB's count, bit
+// 63 (valid) set, at the dump's address + 16 * db. Gnm's query block is {begin, end} per DB:
+// the game zeroes it, dumps at +0 before the draws it measures and at +8 after, and reads the
+// sum of end - begin. Bloodborne tests its culling proxies that way (GX GetData, CPU readback,
+// ~180 blocks a frame in a dense view: when the answer is "no samples" it does not submit the
+// object's draws at all) and also predicates draws on blocks with SET_PREDICATION (Gnm's
+// setZPassPredicationEnable, called from the game at 0x216a79e and 0x2250745).
+//
+// Here:
+// - Stage A counts the draws it decodes and hands each dump to the recording side in order
+//   (RunInOrder). Draws recorded after a dump get a Vulkan occlusion query each, begun and ended
+//   around the vkCmdDraw itself (never across a render pass): up to BB_OCCLUSION_CAP (64) after
+//   a block's begin dump, one after any other dump. An interval holding a draw without a query
+//   (past the cap, filtered, its pipeline not ready yet, failed) reads plainly visible.
+// - At the dump the interval's queries and the block address are queued; once the GPU has
+//   finished that submission (Scheduler::DeferPriorityOperation, its own thread) the results
+//   are read without waiting, a running total is kept like the DBs keep theirs, and the dump
+//   writes it, split over the DBs with the valid bit, into the game's memory. Never a stall:
+//   no thread waits for a query, the game polls its blocks and takes "not ready" as it would on
+//   the PS4 (it keeps the object drawn and asks again).
+// - Fail-safe towards "visible": an unavailable query, a missing query, an imprecise device's
+//   nonzero result, all add a large count. A dump over memory that holds neither the game's
+//   zeroes nor our own last value (freed and reused) is not written, nor one more than
+//   BB_OCCLUSION_MAX_LAG frames late unless we wrote that block before and it is at most twice
+//   that late: the block stays not ready.
+// - Hysteresis against flicker (lamps, glare): a block reports the largest of its last three
+//   results (OcclusionModel::BlockHistory): occluded only after three in a row found nothing,
+//   visible at once.
+// - SET_PREDICATION: the draws between a ZPASS set and its clear are skipped only when every
+//   dump into the block has been resolved and the block reads occluded; otherwise they are
+//   drawn. The results arrive a frame late, so this rarely skips: GPU conditional rendering
+//   would need a render pass split per predicated object to copy the result on the GPU and
+//   would still record every draw (the CPU cost this port is bound by), so it is not done.
+//   BB_FRAME_STATS counts how many predicated draws there are.
+//
+// Latency: an object coming into view is drawn again once the game has read the result of a
+// query it issued while the object was hidden: one or two frames later than on the PS4 (the
+// game itself already lags a frame there). Popping at the edge of occluders is the visible risk.
+
+#pragma once
+
+#include <atomic>
+#include <deque>
+#include <memory>
+#include <mutex>
+#include <unordered_map>
+#include <vector>
+
+#include "common/types.h"
+#include "video_core/renderer_vulkan/vk_common.h"
+
+namespace Vulkan {
+
+class Instance;
+class Scheduler;
+class Rasterizer;
+
+class Occlusion {
+public:
+    /// BB_OCCLUSION (default on). Off: the fake counts and SET_PREDICATION ignored, as before.
+    static bool Wanted();
+
+    /// Null when the device cannot do it (no host query reset, no query pool): the fake then.
+    static std::unique_ptr<Occlusion> Create(const Instance& instance, Scheduler& scheduler,
+                                             Rasterizer& rasterizer);
+    ~Occlusion();
+
+    /// Stage A (GPU command thread): a draw packet decoded (direct or indirect).
+    void NoteIssued() noexcept {
+        ++issued;
+    }
+
+    /// Stage A: what a dump hands to the recording side.
+    struct DumpTask {
+        VAddr va;
+        u64 issued;    ///< draws decoded before the dump
+        u64 frame;     ///< sceGnmSubmitDone calls when it was decoded
+        u32 pipes;     ///< DBs the dump writes
+        u32 pad;
+    };
+    DumpTask MakeDump(VAddr va, u32 num_pipes) const noexcept;
+
+    struct PredicationTask {
+        VAddr block;
+        u32 op; ///< 0 clear, 1 ZPASS, 2 primitive count (not emulated: drawn)
+        u8 draw_if_visible;
+        u8 cont;
+        u16 pad;
+    };
+    /// Stage A: whether a SET_PREDICATION region is open (the submission end clears it).
+    bool predication_open = false;
+
+    /// Dumps were queued into the submission `current_tick` (not sent to the GPU yet). Read on
+    /// stage A with the draw pipe drained.
+    bool HasUnsubmittedDumps(u64 current_tick) const noexcept {
+        return registered_tick == current_tick;
+    }
+
+    // ---- the recording side (stage B, or stage A after a drain), in stream order ----
+    void Dump(const DumpTask& task);
+    void SetPredication(const PredicationTask& task);
+    /// At the start of a draw's recording: true when SET_PREDICATION skips it.
+    bool SkipDraw() noexcept {
+        if (pred_mode == PredMode::None) [[likely]] {
+            return false;
+        }
+        return SkipPredicated();
+    }
+    /// The query to wrap the draw about to be recorded in (pool null: none). `scene_size`: the
+    /// draw's push_data.scene_size (reduced scene targets count fewer samples).
+    struct DrawQuery {
+        vk::QueryPool pool{};
+        u32 index = 0;
+        vk::QueryControlFlags flags{};
+    };
+    DrawQuery BeginDraw(u32 scene_size) noexcept {
+        if (!interval.open || interval.queries >= interval.cap) [[likely]] {
+            return {};
+        }
+        return AllocateQuery(scene_size);
+    }
+    /// bbport: whether BeginDraw would measure the next draw. A draw the game measures is never
+    /// left out while its pipeline compiles (Rasterizer::SkipUncompiledDraw): zero samples
+    /// would read as occluded and its predicated draws would vanish too.
+    [[nodiscard]] bool Measuring() const noexcept {
+        return interval.open && interval.queries < interval.cap;
+    }
+
+private:
+    Occlusion(const Instance& instance, Scheduler& scheduler, Rasterizer& rasterizer);
+    bool Init();
+    DrawQuery AllocateQuery(u32 scene_size) noexcept;
+    bool SkipPredicated() noexcept;
+
+    static constexpr u32 PoolSize = 16384;
+
+    const Instance& instance;
+    Scheduler& scheduler;
+    Rasterizer& rasterizer;
+    bool precise = false;
+    u32 cap = 64;
+    u32 pipes = 8; ///< DBs of the last dump (a Neo has 16)
+
+    // Stage A.
+    u64 issued = 0;
+
+    // The recording side.
+    struct Interval {
+        bool open = false;
+        u32 cap = 0;
+        u32 queries = 0;    ///< queries handed out in it (one per measured draw)
+        u64 first = 0;      ///< its first query, as a running count
+        u64 issued_at = 0;  ///< stage A's draw count at the dump that opened it
+    } interval;
+    u64 query_head = 0;     ///< queries handed out so far
+    u64 dump_serial = 0;
+    u64 registered_tick = ~0ull;
+    std::unordered_map<VAddr, u64> block_serial; ///< a block's last dump (either half)
+    enum class PredMode : u8 { None, Skip, Draw };
+    PredMode pred_mode = PredMode::None;
+    bool pred_visible = false, pred_unknown = false; ///< CONTINUE chains OR blocks together
+
+    /// What the resolver thread and the recording side share.
+    struct Shared;
+    std::shared_ptr<Shared> shared;
+};
+
+} // namespace Vulkan
diff --git a/gpu/shadps4/video_core/texture_cache/watched_pages.h b/gpu/shadps4/video_core/texture_cache/watched_pages.h
new file mode 100644
index 0000000..2336643
--- /dev/null
+++ b/gpu/shadps4/video_core/texture_cache/watched_pages.h
@@ -0,0 +1,88 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// bbport: how many tracked images watch each guest page, readable without the texture cache's
+// lock (docs/pipeline_compiles.md, "Write faults"). No Vulkan here: tests/test_pipeline_compile.cpp.
+
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <vector>
+
+namespace VideoCore {
+
+/// The pages each tracked image protects (TextureCache::TrackImage and the Untrack functions:
+/// the same ranges, counted per page as the page manager counts them), per 4 KiB page. A write
+/// fault on a page no tracked image watches (a buffer's page, most faults) needs nothing from
+/// the texture cache: the guest thread then does not take its lock, which the draw recording
+/// thread holds while it creates an image or uploads one (0.5-0.6 s each with memory short).
+///
+/// Writers hold the texture cache's lock (one at a time); readers may be any thread. A reader
+/// that races with a track sees the page either way: unwatched, its write lands before the
+/// image's upload reads the memory; watched, it takes the lock as before. Counts go up before
+/// the pages are protected and down after they are unprotected.
+class WatchedPages {
+public:
+    static constexpr std::uint32_t PageBits = 12;      ///< the page manager's 4 KiB pages
+    static constexpr std::uint32_t ChunkPageBits = 16; ///< 256 MiB of guest memory per chunk
+    static constexpr std::uint32_t AddressBits = 40;   ///< guest addresses (page manager)
+
+    /// `delta` (+1/-1) for every page of [address, address + size), as
+    /// PageManager::UpdatePageWatchers counts them. Writers hold the texture cache's lock.
+    void Add(std::uint64_t address, std::uint64_t size, int delta) {
+        const std::uint64_t first = address >> PageBits;
+        const std::uint64_t end = (address + size + PageSize - 1) >> PageBits;
+        for (std::uint64_t page = first; page < end; ++page) {
+            const std::uint64_t chunk = page >> ChunkPageBits;
+            if (chunk >= NumChunks) {
+                return;
+            }
+            Count* counts = chunks[chunk].load(std::memory_order_relaxed);
+            if (!counts) {
+                if (delta < 0) {
+                    continue;
+                }
+                owned.push_back(std::make_unique<Count[]>(ChunkPages));
+                counts = owned.back().get();
+                chunks[chunk].store(counts, std::memory_order_release);
+            }
+            Count& count = counts[page & (ChunkPages - 1)];
+            const std::uint32_t now = count.load(std::memory_order_relaxed);
+            // One writer: a plain read-modify-write (no locked instruction per page).
+            count.store(static_cast<std::uint16_t>(delta < 0 ? (now ? now - 1 : 0) : now + 1),
+                        std::memory_order_release);
+        }
+    }
+
+    /// Whether a tracked image watches a page of [address, address + size). Any thread.
+    [[nodiscard]] bool Any(std::uint64_t address, std::uint64_t size) const noexcept {
+        const std::uint64_t first = address >> PageBits;
+        const std::uint64_t end = (address + std::max<std::uint64_t>(size, 1) + PageSize - 1) >>
+                                  PageBits;
+        for (std::uint64_t page = first; page < end; ++page) {
+            const std::uint64_t chunk = page >> ChunkPageBits;
+            if (chunk >= NumChunks) {
+                return true; // outside the table: assume watched (the locked path)
+            }
+            const Count* counts = chunks[chunk].load(std::memory_order_acquire);
+            if (counts && counts[page & (ChunkPages - 1)].load(std::memory_order_acquire) != 0) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+private:
+    using Count = std::atomic<std::uint16_t>;
+    static constexpr std::uint64_t PageSize = std::uint64_t{1} << PageBits;
+    static constexpr std::size_t ChunkPages = std::size_t{1} << ChunkPageBits;
+    static constexpr std::size_t NumChunks = std::size_t{1}
+                                             << (AddressBits - PageBits - ChunkPageBits);
+    std::array<std::atomic<Count*>, NumChunks> chunks{};
+    std::vector<std::unique_ptr<Count[]>> owned; ///< writers only
+};
+
+} // namespace VideoCore
diff --git a/gpu/shim/bbport_menu_i18n.cpp b/gpu/shim/bbport_menu_i18n.cpp
new file mode 100644
index 0000000..205ab5c
--- /dev/null
+++ b/gpu/shim/bbport_menu_i18n.cpp
@@ -0,0 +1,1283 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// bbport: the in-game menu (bbport_overlay.cpp) in the languages other than English and
+// Russian, which MenuText takes at its call sites. Each table maps the English text, exactly as
