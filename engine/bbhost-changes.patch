--- /dev/null
+++ b/gpu/shadps4/video_core/renderer_vulkan/host_passes/hdr_pass.h
@@ -0,0 +1,60 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// bbport: HDR output (hdr in bbport.ini). Encodes the swapchain-sized SDR composite (the game's
+// frame letterboxed, plus the menu layer) into the HDR swapchain image: HDR10 PQ or scRGB.
+// Native mode (hdr_mode=native) brightens the highlights with the frame's gain map
+// (vk_hdr_native.h).
+
+#pragma once
+
+#include <array>
+
+#include "common/types.h"
+#include "video_core/renderer_vulkan/vk_common.h"
+
+namespace Vulkan::HostPasses {
+
+class HdrOutputPass {
+public:
+    /// Push constants of hdr_output.frag.
+    struct Settings {
+        float paper_white = 200.0f; ///< nits of SDR white
+        float peak = 1000.0f;       ///< nits the display reaches
+        float boost = 0.5f;         ///< highlight expansion, 0..1 (expand mode and fallback)
+        u32 flags = 0;              ///< FlagScRgb | FlagOverlay | FlagNative | FlagDebug
+        /// FlagNative: the frame's rectangle in the output (top left corner, pixels) and
+        /// 1 / its size, mapping output pixels to gain map coordinates.
+        std::array<float, 2> gain_offset{};
+        std::array<float, 2> gain_scale{};
+        /// Native mode: the UI's white (times paper white) and colours (0 sRGB .. 1 DCI-P3).
+        float ui_white = 1.0f;
+        float ui_vivid = 0.0f;
+    };
+    static constexpr u32 FlagScRgb = 1;   ///< scRGB (linear BT.709) output, else HDR10 PQ
+    static constexpr u32 FlagOverlay = 2; ///< the menu layer is drawn
+    static constexpr u32 FlagNative = 4;  ///< `gain` is this frame's gain map (native mode)
+    static constexpr u32 FlagDebug = 8;   ///< BB_HDR_DEBUG: the gain as a heat map
+    static constexpr u32 FlagUiFrame = 16; ///< native mode, a frame without a scene: all UI
+
+    /// `output_format`: the HDR swapchain's format.
+    void Create(vk::Device device, vk::Format output_format);
+
+    bool IsCreated() const {
+        return static_cast<bool>(pipeline);
+    }
+
+    /// Draws into `output` (layout ColorAttachmentOptimal) of `extent`; `game` and `overlay`
+    /// (both ShaderReadOnlyOptimal, `extent` big) are read texel for texel, `gain` (any size,
+    /// in `gain_layout`) is filtered.
+    void Render(vk::CommandBuffer cmdbuf, vk::ImageView game, vk::ImageView overlay,
+                vk::ImageView gain, vk::ImageLayout gain_layout, vk::ImageView output,
+                vk::Extent2D extent, const Settings& settings);
+
+private:
+    vk::UniquePipeline pipeline{};
+    vk::UniquePipelineLayout pipeline_layout{};
+    vk::UniqueDescriptorSetLayout desc_set_layout{};
+    vk::UniqueSampler sampler{};
+    vk::UniqueSampler gain_sampler{}; ///< bilinear: the map has the display buffer's size
+};
+
+} // namespace Vulkan::HostPasses
diff --git a/gpu/shadps4/video_core/renderer_vulkan/occlusion_model.h b/gpu/shadps4/video_core/renderer_vulkan/occlusion_model.h
new file mode 100644
index 0000000..930b227
--- /dev/null
+++ b/gpu/shadps4/video_core/renderer_vulkan/occlusion_model.h
@@ -0,0 +1,93 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// bbport: the PS4 depth-block counter model behind real occlusion results (vk_occlusion.h),
+// without Vulkan, so the arithmetic is unit-tested (tests/test_occlusion.cpp).
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+
+namespace OcclusionModel {
+
+constexpr std::uint64_t ValidBit = 1ull << 63;
+/// What a draw without a usable result adds: plainly visible (the old fake's step), so any
+/// begin/end pair around it reads visible, never occluded.
+constexpr std::uint64_t Unmeasured = 0x2FFFFFFull;
+constexpr std::uint32_t MaxPipes = 16;
+
+/// DB `k`'s share of the running total: the shares sum to `total` and each grows with it, so the
+/// game's sum of end - begin over the DBs is exactly the samples in between.
+constexpr std::uint64_t Share(std::uint64_t total, std::uint32_t pipes, std::uint32_t k) {
+    return total / pipes + (k < total % pipes ? 1 : 0);
+}
+
+enum class Block : std::uint32_t { Occluded = 0, Visible = 1, NotReady = 2 };
+
+/// A Gnm block ({begin, end} per DB, 16 bytes apart) as the game reads it.
+inline Block ReadBlock(const std::uint64_t* words, std::uint32_t pipes) {
+    std::uint64_t sum = 0;
+    for (std::uint32_t k = 0; k < pipes; ++k) {
+        const std::uint64_t b = words[2 * k], e = words[2 * k + 1];
+        if (!(b & ValidBit) || !(e & ValidBit)) {
+            return Block::NotReady;
+        }
+        sum += (e & ~ValidBit) - (b & ~ValidBit);
+    }
+    return sum != 0 ? Block::Visible : Block::Occluded;
+}
+
+/// 16.16 factor taking samples counted at `width` x `height` (reduced scene targets) back to the
+/// PS4's 1920x1080; never below 1.
+constexpr std::uint32_t SampleScale(std::uint32_t width, std::uint32_t height) {
+    const std::uint64_t pixels = std::uint64_t(width) * height;
+    constexpr std::uint64_t native = 1920ull * 1080ull;
+    if (pixels == 0 || pixels >= native) {
+        return 1u << 16;
+    }
+    return static_cast<std::uint32_t>((native << 16) / pixels);
+}
+
+/// One query's contribution: unavailable reads visible; an imprecise device's nonzero result
+/// (0/1 on NVIDIA) reads plainly visible; a precise count is scaled, rounding up.
+constexpr std::uint64_t Samples(std::uint64_t value, bool available, bool precise,
+                                std::uint32_t scale) {
+    if (!available) {
+        return Unmeasured;
+    }
+    if (!precise) {
+        return value ? Unmeasured : 0;
+    }
+    return std::max<std::uint64_t>((value * scale + 0xFFFF) >> 16, value);
+}
+
+/// SET_PREDICATION's outcome for the draws up to its clear: unknown draws (a wrong "occluded"
+/// makes geometry vanish), else draw when the visibility is the one asked for.
+constexpr bool PredicatedDraws(bool visible, bool unknown, bool draw_if_visible) {
+    return unknown || visible == draw_if_visible;
+}
+
+/// Hysteresis per Gnm block against flicker (lamps and their glare at the edge of occluders:
+/// sample counts of small proxies going 0/N/0 with the jittered, reduced scene): a block
+/// reports the largest of its last `Depth` measured counts. It reads occluded only after Depth
+/// results in a row found no samples, visible as soon as one finds any. Results it has not seen
+/// count as `UnknownPast`: visible, with the smallest count (a count-scaled effect stays dark
+/// rather than flashing).
+struct BlockHistory {
+    static constexpr std::uint32_t Depth = 3;
+    static constexpr std::uint64_t UnknownPast = 1;
+    std::uint64_t previous[Depth - 1] = {UnknownPast, UnknownPast};
+
+    /// The count to report for the block's new result `measured`, which is remembered.
+    constexpr std::uint64_t Report(std::uint64_t measured) {
+        std::uint64_t reported = measured;
+        for (const std::uint64_t p : previous) {
+            reported = std::max(reported, p);
+        }
+        for (std::uint32_t i = Depth - 2; i > 0; --i) {
+            previous[i] = previous[i - 1];
+        }
+        previous[0] = measured;
+        return reported;
+    }
+};
+
+} // namespace OcclusionModel
diff --git a/gpu/shadps4/video_core/renderer_vulkan/pipeline_compile_queue.h b/gpu/shadps4/video_core/renderer_vulkan/pipeline_compile_queue.h
new file mode 100644
index 0000000..766462b
--- /dev/null
+++ b/gpu/shadps4/video_core/renderer_vulkan/pipeline_compile_queue.h
@@ -0,0 +1,110 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// bbport: pipelines first seen during play (docs/pipeline_compiles.md). The compile threads'
+// job queue, from which a thread that needs a pipeline right away takes its job, the rule for
+// how long draws of a pipeline still compiling may be left out, and the statistics of both
+// (BB_FRAME_STATS "Pipelines:" line). No Vulkan here: tests/test_pipeline_compile.cpp.
+
+#pragma once
+
+#include <algorithm>
+#include <atomic>
+#include <condition_variable>
+#include <cstddef>
+#include <cstdint>
+#include <deque>
+#include <functional>
+#include <mutex>
+#include <utility>
+
+namespace Vulkan {
+
+/// Compile jobs, first in, first out (the order the draws need them in), each with the object
+/// it creates (`owner`). A thread about to wait for that object takes its job when no compile
+/// thread has started it yet (Take) and runs it itself, instead of waiting behind the jobs
+/// queued before it (20-90 pipelines at once entering an area).
+class PipelineJobQueue {
+public:
+    using Job = std::function<void()>;
+
+    void Push(const void* owner, Job job) {
+        {
+            std::scoped_lock lk{mutex};
+            jobs.push_back({owner, std::move(job)});
+        }
+        cv.notify_one();
+    }
+
+    /// A compile thread: the oldest job (waits for one).
+    Job Pop() {
+        std::unique_lock lk{mutex};
+        cv.wait(lk, [this] { return !jobs.empty(); });
+        Job job = std::move(jobs.front().job);
+        jobs.pop_front();
+        return job;
+    }
+
+    /// `owner`'s job, taken out of the queue, when no thread has started it; else empty.
+    Job Take(const void* owner) {
+        std::scoped_lock lk{mutex};
+        const auto it =
+            std::find_if(jobs.begin(), jobs.end(), [owner](const Entry& e) { return e.owner == owner; });
+        if (it == jobs.end()) {
+            return {};
+        }
+        Job job = std::move(it->job);
+        jobs.erase(it);
+        return job;
+    }
+
+    [[nodiscard]] std::size_t Size() {
+        std::scoped_lock lk{mutex};
+        return jobs.size();
+    }
+
+private:
+    struct Entry {
+        const void* owner;
+        Job job;
+    };
+    std::mutex mutex;
+    std::condition_variable cv;
+    std::deque<Entry> jobs;
+};
+
+/// Whether a draw of a pipeline still compiling may be left out now. `first_skip_ns`: when one
+/// of its draws was first left out (0: none yet; set here), `budget_ns`: for how long its draws
+/// may be left out. Past that they wait for it: a compile that never ends (or a queue that does
+/// not move) shows as a stall, not as geometry missing for good.
+inline bool WithinSkipBudget(std::uint64_t& first_skip_ns, std::uint64_t now_ns,
+                             std::uint64_t budget_ns) noexcept {
+    if (first_skip_ns == 0) {
+        first_skip_ns = now_ns != 0 ? now_ns : 1;
+        return budget_ns != 0;
+    }
+    return now_ns - first_skip_ns < budget_ns;
+}
+
+/// Counted since the last statistics window (BB_FRAME_STATS), exchanged to 0 when printed.
+struct PipelineCompileStats {
+    std::atomic<std::uint64_t> background{0};        ///< pipelines handed to the compile threads
+    std::atomic<std::uint64_t> taken{0};             ///< compiled by the thread that needed them
+    std::atomic<std::uint64_t> skipped_draws{0};     ///< draws left out, their pipeline compiling
+    std::atomic<std::uint64_t> skipped_pipelines{0}; ///< pipelines whose draws were left out
+    std::atomic<std::uint64_t> late_binds{0};        ///< draws bound on the recording threads
+    std::atomic<std::uint64_t> waits{0};             ///< threads that waited for a compile
+    std::atomic<std::uint64_t> wait_ns{0};
+    std::atomic<std::uint64_t> longest_wait_ns{0};
+
+    void NoteWait(std::uint64_t ns) noexcept {
+        waits.fetch_add(1, std::memory_order_relaxed);
+        wait_ns.fetch_add(ns, std::memory_order_relaxed);
+        std::uint64_t longest = longest_wait_ns.load(std::memory_order_relaxed);
+        while (ns > longest &&
+               !longest_wait_ns.compare_exchange_weak(longest, ns, std::memory_order_relaxed)) {
+        }
+    }
+};
+
+inline PipelineCompileStats pipeline_compile_stats;
+
+} // namespace Vulkan
