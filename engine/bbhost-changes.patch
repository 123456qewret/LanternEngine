+        barrier(swapchain_image, Layout::eColorAttachmentOptimal, Layout::ePresentSrcKHR,
+                Stage::eColorAttachmentOutput, Access::eColorAttachmentWrite,
+                Stage::eBottomOfPipe, Access::eNone),
+    };
