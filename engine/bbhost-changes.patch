+    char* end = nullptr;
+    const long v = std::strtol(value.c_str(), &end, 10);
+    if (!value.empty() && end && *end == '\0' && std::find(choices, choices + N, int(v)) != choices + N) {
+        return int(v);
+    }
+    std::printf("Settings: unknown %s '%s' (expected %s); %d\n", key.c_str(), value.c_str(), expected, choices[0]);
+    return choices[0];
