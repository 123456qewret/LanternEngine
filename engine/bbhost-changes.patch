+vk::Sampler Rasterizer::CachedSampler(const AmdGpu::Sampler& sharp, bool is_depth,
+                                      float lod_bias) {
+    static const bool enabled = [] {
+        const char* env = std::getenv("BB_SAMPLER_MEMO");
+        return !(env && env[0] == '0');
+    }();
+    if (!enabled) {
